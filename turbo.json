{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env", 
    "**/.env.*local"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/skills/**", "$TURBO_ROOT$/skill-specs/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "preview": {
      "cache": false
    },
    "preview:wrangler": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "NOTIFY_WEBHOOK_URL", "GH_TOKEN"]
    },
    "deploy:wrangler": {
      "cache": false,
      "passThroughEnv": ["CLOUDFLARE_API_TOKEN", "CLOUDFLARE_ACCOUNT_ID", "NOTIFY_WEBHOOK_URL", "GH_TOKEN"]
    },
    "deploy:netlify": {
      "cache": false,
      "passThroughEnv": ["NETLIFY_AUTH_TOKEN", "NETLIFY_SITE_ID"]
    },
    "build:netlify": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    }
  }
}
