// The site's page redirects. Each key is the path a visitor requests and "to"
// is where it sends them. Read by astro.config.mjs. (The trailing-slash
// catch-all, Cloudflare's own .html and slash handling, and the apex-to-www
// rule live elsewhere: see CONTEXT-MEMORY.md, Deployment.)
//
// "permanent": true sends a 301. Browsers cache a 301 indefinitely and search
// engines treat it as a move, so once visitors have followed one, changing its
// target no longer reaches them. Leave "permanent" out for a 302, which nobody
// caches, so the target can still change later (vanity URLs).
//
// The markdown twin of each redirect (/a.md -> /b.md, same status) is derived
// by src/lib/mdtwins/redirects.ts, so it is never listed here.
//
// Whether a moved page needs a redirect, and which kind, is the owner's
// decision, not an agent's: ask. Write the reason in a comment above each
// entry so it is still known later.
{

  // Vanity URL for the pg_semantius docs. The target may move, so it is a 302.
  "/pg_semantius": { "to": "/docs/pg-semantius" },
  "/pg-semantius": { "to": "/docs/pg-semantius" },

  // Vanity URLs linked from the home page hero diagram's two lower boxes
  // ("Team App" and "Agent API & CLI"). The targets may move, so they are 302s.
  "/app": { "to": "/docs/app" },
  "/agents": { "to": "/docs/agent-skills" }
}
