---
import Schema from '../layout/Schema.astro';
import { ChevronDown } from 'lucide-react';

interface FAQItem {
  question: string;
  /** Trusted HTML written in this repo, so an answer can carry a link. */
  answer: string;
}

interface Props {
  items: FAQItem[];
  title?: string;
  subtitle?: string;
}

// The subtitle renders only when a page passes one.
const { items, title = 'Frequently Asked Questions', subtitle } = Astro.props;

const plainText = (html: string) =>
  html.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/\s+/g, ' ').trim();

const schema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map(item => ({
    "@type": "Question",
    "name": item.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": plainText(item.answer)
    }
  }))
};
---

<Schema item={schema} />

<section class="py-24 relative overflow-hidden" id="faq">
    <div class="max-w-3xl mx-auto px-6 relative z-10">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-5xl font-display font-bold mb-6">{title}</h2>
            {subtitle && <p class="text-lg text-muted-foreground">{subtitle}</p>}
        </div>

        <div class="space-y-4">
            {items.map((faq) => (
                <details class="group border border-foreground/10 bg-foreground/2 hover:bg-foreground/4 rounded-2xl transition-colors duration-300 open:border-primary/30">
                    <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
                        {/* A heading, so the markdown twin and search keep each question as one. */}
                        <h3 class="text-lg font-medium pr-8">{faq.question}</h3>
                        <span class="transition-transform duration-300 group-open:rotate-180 text-primary">
                            <ChevronDown className="w-5 h-5" aria-hidden="true" />
                        </span>
                    </summary>
                    <div class="faq-answer px-6 pb-6 text-muted-foreground leading-relaxed" set:html={faq.answer} />
                </details>
            ))}
        </div>
    </div>
</section>

<style>
    details[open] summary ~ * {
        animation: accordion-down 0.3s ease-out;
    }

    .faq-answer :global(a) {
        color: var(--color-primary);
    }

    .faq-answer :global(a:hover) {
        text-decoration: underline;
    }

    @keyframes accordion-down {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
