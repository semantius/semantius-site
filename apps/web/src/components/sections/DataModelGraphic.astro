---
/**
 * The hub hero's graphic (change request 1, §2): one node, "Active data
 * dictionary", branching into three layers, each with one plain line. It names
 * no technology: on the hub those names appear only in the specifications
 * section and the footer.
 */
const outputs = [
  { layer: 'Data layer', line: 'Your records and rules, checked on every change.' },
  { layer: 'Agent layer', line: 'Each agent works under its own login and role.' },
  { layer: 'Human-in-the-loop layer', line: 'Your team approves what matters and sees only their part.' },
];
---

<figure class="mx-auto w-full max-w-lg">
  <div class="mx-auto w-fit rounded-2xl border-2 border-primary bg-primary/10 px-6 py-4 text-center text-lg font-bold">
    Active data dictionary
  </div>
  <div class="mx-auto h-6 w-0.5 bg-primary/60" aria-hidden="true"></div>
  <div class="relative sm:pt-6">
    {/* The bar joins the centers of the outer cards; on a phone the cards stack. */}
    <span class="absolute top-0 left-[16.67%] right-[16.67%] hidden h-0.5 bg-primary/60 sm:block" aria-hidden="true"></span>
    <ul class="grid gap-3 sm:grid-cols-3">
      {outputs.map((o) => (
        <li class="relative rounded-xl border border-foreground/15 bg-foreground/5 p-4 text-center">
          <span class="absolute -top-6 left-1/2 hidden h-6 w-0.5 -translate-x-1/2 bg-primary/60 sm:block" aria-hidden="true"></span>
          <span class="block font-semibold">{o.layer}</span>
          <span class="mt-2 block text-sm text-foreground/75">{o.line}</span>
        </li>
      ))}
    </ul>
  </div>
</figure>
