---
/**
 * "Show the code" for the demo (founder's v1 spec, §4.5): four tabs over the
 * recorded walkthrough's real artifacts. Closed on the hub, open on Agent
 * guardrails (§5.3). The artifacts do not exist yet (home-tbd.md, A1).
 */
import Tbd from '~/components/common/Tbd.astro';

interface Props {
  open?: boolean;
}

const { open = false } = Astro.props;

const tabs = [
  { key: 'model', label: 'The model definition' },
  { key: 'schema', label: 'The Postgres schema, the approval step and the permission on it' },
  { key: 'request', label: 'The PostgREST request (curl) and its response' },
  { key: 'form', label: 'The generated React form' },
];
---

<details class="demo-code group rounded-2xl border border-foreground/10 bg-foreground/2 text-left" open={open}>
  <summary class="flex cursor-pointer list-none items-center justify-between p-5 font-semibold">
    Show the code
    <span class="text-primary transition-transform group-open:rotate-180" aria-hidden="true">▾</span>
  </summary>
  <div class="px-5 pb-5">
    <div role="tablist" aria-label="Show the code" class="flex flex-wrap gap-2 border-b border-foreground/10 pb-3">
      {tabs.map((t, i) => (
        <button
          type="button"
          role="tab"
          id={`demo-tab-${t.key}`}
          aria-controls={`demo-panel-${t.key}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="rounded-lg px-3 py-1.5 text-left text-sm text-foreground/70 hover:bg-foreground/5 aria-selected:bg-primary/10 aria-selected:font-medium aria-selected:text-foreground"
        >
          {t.label}
        </button>
      ))}
    </div>
    {tabs.map((t, i) => (
      <div role="tabpanel" id={`demo-panel-${t.key}`} aria-labelledby={`demo-tab-${t.key}`} class="pt-4" hidden={i !== 0}>
        <Tbd block note={`${t.label}, taken from the recorded demo. Not produced yet.`} />
      </div>
    ))}
  </div>
</details>

<script>
  document.querySelectorAll<HTMLElement>('.demo-code [role="tablist"]').forEach((list) => {
    const tabs = Array.from(list.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        for (const t of tabs) {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
          if (panel) panel.hidden = !on;
        }
      });
    });
  });
</script>
