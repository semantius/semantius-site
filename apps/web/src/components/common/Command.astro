---
type Mode = "chat" | "shell";

interface Props {
  command: string;
  mode?: Mode;
  /**
   * Sample-prompt box: copy and run sit above an editable prompt.
   * Copy tooltip is "copy for your agent". Run tooltip is
   * "Start the semantius agent"; it writes cookie agent_prompt
   * (Domain=.semantius.com) and opens https://app.semantius.com/copilot.
   */
  runnable?: boolean;
}

// Map of slash-prefixed skill names to the docs page that documents the skill.
// In chat mode, a leading /skill token is rendered as a link to the matching
// docs page (or as plain styled text if the skill is not in this map).
const SKILL_DOC_MAP: Record<string, string> = {
  "/semantic-model-analyst": "/docs/models/create",
  "/semantic-model-deployer": "/docs/models/deploy",
  "/semantic-model-optimizer": "/docs/models/optimize",
};

const { command, mode = "shell", runnable = false } = Astro.props;

const skillMatch = !runnable && mode === "chat" ? command.match(/^(\/[\w-]+)(\s[\s\S]*)?$/) : null;
const skill = skillMatch?.[1] ?? null;
const skillRest = skillMatch?.[2] ?? "";
const skillHref = skill ? SKILL_DOC_MAP[skill] ?? null : null;
---

<div class:list={["command", "not-prose", "group", `is-${mode}`, runnable && "is-runnable"]}>
  {runnable && (
    <div class="command-toolbar">
      <button
        type="button"
        class="command-copy"
        data-command={command}
        aria-label="copy for your agent"
        title="copy for your agent"
      >
        <svg
          class="command-icon-copy"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg
          class="command-icon-check"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="command-copy-label">Copy</span>
      </button>
      <button
        type="button"
        class="command-run"
        data-command={command}
        aria-label="Start the semantius agent"
        title="Start the semantius agent"
      >
        <svg
          class="command-icon-run"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polygon points="6 3 20 12 6 21 6 3"></polygon>
        </svg>
        <span class="command-run-label">Run</span>
      </button>
    </div>
  )}
  {runnable ? (
    <textarea class="command-text command-prompt" rows="4">{command}</textarea>
  ) : (
    <>
      <code class="command-text">
        {skill && skillHref && (
          <>
            <a href={skillHref} class="command-skill-prefix">{skill}</a>{skillRest}
          </>
        )}
        {skill && !skillHref && (
          <>
            <span class="command-skill-prefix">{skill}</span>{skillRest}
          </>
        )}
        {!skill && command}
      </code>
      <button
        type="button"
        class="command-copy"
        data-command={command}
        aria-label="Copy command"
      >
        <svg
          class="command-icon-copy"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg
          class="command-icon-check"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
        <span class="command-copy-label">Copy</span>
      </button>
    </>
  )}
</div>

<script>
  const COPILOT_URL = "https://app.semantius.com/copilot";
  const AGENT_PROMPT_COOKIE = "agent_prompt";

  function currentCommand(wrapper: Element | null, fallback: string): string {
    const prompt = wrapper?.querySelector<HTMLTextAreaElement>(".command-prompt");
    return prompt?.value ?? fallback;
  }

  async function copyText(text: string): Promise<void> {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.opacity = "0";
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand("copy");
      document.body.removeChild(textarea);
    }
  }

  function setAgentPromptCookie(value: string): void {
    // Cross-subdomain so app.semantius.com can read it after the redirect.
    // Browsers reject Domain=.semantius.com on any other host (preview, localhost).
    const parts = [
      `${AGENT_PROMPT_COOKIE}=${encodeURIComponent(value)}`,
      "path=/",
      "secure",
      "samesite=lax",
    ];
    const host = location.hostname;
    if (host === "semantius.com" || host.endsWith(".semantius.com")) {
      parts.push("domain=.semantius.com");
    }
    document.cookie = parts.join("; ");
  }

  function sizePrompt(textarea: HTMLTextAreaElement): void {
    textarea.style.height = "auto";
    textarea.style.height = `${textarea.scrollHeight}px`;
  }

  function sizePrompts(): void {
    document.querySelectorAll<HTMLTextAreaElement>(".command-prompt").forEach(sizePrompt);
  }

  document.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement | null;

    const runButton = target?.closest<HTMLButtonElement>(".command-run");
    if (runButton) {
      const wrapper = runButton.closest(".command");
      const command = currentCommand(wrapper, runButton.dataset.command ?? "");
      setAgentPromptCookie(command);
      window.location.assign(COPILOT_URL);
      return;
    }

    const button = target?.closest<HTMLButtonElement>(".command-copy");
    if (!button) return;

    const wrapper = button.closest(".command");
    const command = currentCommand(wrapper, button.dataset.command ?? "");
    const label = button.querySelector<HTMLElement>(".command-copy-label");
    const originalLabel = label?.textContent ?? "Copy";

    await copyText(command);

    wrapper?.classList.add("copied");
    if (label) label.textContent = "Copied";

    setTimeout(() => {
      wrapper?.classList.remove("copied");
      if (label) label.textContent = originalLabel;
    }, 1600);
  });

  document.addEventListener("input", (event) => {
    const target = event.target;
    if (target instanceof HTMLTextAreaElement && target.classList.contains("command-prompt")) {
      sizePrompt(target);
    }
  });

  sizePrompts();
  document.addEventListener("astro:page-load", sizePrompts);
</script>
