---
// The two install steps (founder's v1 spec, §4.5), on every sample-prompt page.
// Change request 1 took them off the hub and Agent guardrails; the founder kept
// them on the prompt pages (home-deviations.md, 47).
import Command from '~/components/common/Command.astro';
import { INSTALL_CLI, INSTALL_SKILL, OPENCLAW_NOTE } from '~/data/install-steps';
---

{/* Not an <ol>: the step numbers are part of the copy, so a list would number
    them twice, for screen readers and in the page's markdown twin. */}
<div class="space-y-6 text-left">
  <div>
    <p class="font-semibold mb-2">1. Install the CLI</p>
    <Command command={INSTALL_CLI} />
  </div>
  <div>
    <p class="font-semibold mb-2">2. Install the skill</p>
    <Command command={INSTALL_SKILL} />
    <p class="mt-2 text-sm text-foreground/70">{OPENCLAW_NOTE}</p>
  </div>
</div>
