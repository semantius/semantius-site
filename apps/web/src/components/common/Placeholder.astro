---
/**
 * A visible stand-in for copy or a link target that is not decided yet.
 *
 * A page carrying one is a preview, not a release: the production branch of
 * `workplace/deploy-wrangler.sh` refuses to deploy while any built page
 * contains `data-copy-placeholder`. (Not `data-placeholder`: the search
 * trigger already uses that for its input hint.)
 *
 * `data-pagefind-ignore` keeps the stand-in text out of site search and out of
 * the page's markdown twin, which read the same content selectors.
 */
import { twMerge } from 'tailwind-merge';
import clsx from 'clsx';

interface Props {
  /** What will go here, such as the section it stands in for. */
  label: string;
  /** What is missing. */
  note?: string;
  class?: string;
}

const { label, note, class: className } = Astro.props;
---

<div
  data-copy-placeholder
  data-pagefind-ignore
  class={twMerge(clsx('rounded-3xl border-2 border-dashed border-amber-500/40 bg-amber-500/5 p-6 md:p-8 text-left', className))}
>
  <span class="inline-flex items-center rounded-full border border-amber-500/40 bg-amber-500/10 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wide text-amber-700 dark:text-amber-300">
    Placeholder
  </span>
  <p class="mt-3 text-lg font-semibold">{label}</p>
  {note && <p class="mt-1 text-sm text-muted-foreground">{note}</p>}
  <slot />
</div>
