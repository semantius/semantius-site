---
/**
 * A link to a GitHub repository, shown as a card: name, license and a one-line
 * description. Used inline from MDX:
 *
 *   <RepoCard repo="semantius/semantius-self-hosted" license="MIT"
 *     description="The whole platform in one Docker Compose setup." />
 *
 * The markdown twin cannot run this component, so `rewriteMdx()` in
 * lib/dualmark/source.ts writes its markdown form from the same attributes.
 * Both take the URL from lib/repo-card.ts.
 *
 * Styling is Tailwind utilities only. A scoped <style> would not load when the
 * component is rendered only from MDX (see "Astro component styles inside MDX
 * prose" in CONTEXT-MEMORY.md). Avoid <code> inside it: typography.css sizes
 * `.prose :where(:not(pre)) > code` without honoring not-prose, and that
 * unlayered rule beats any text-size utility.
 */
import { repoUrl } from '~/lib/repo-card';

interface Props {
	/** owner/name on GitHub, e.g. "semantius/semantius-self-hosted". */
	repo: string;
	license?: string;
	description?: string;
}

const { repo, license, description } = Astro.props;
---

<a
	href={repoUrl(repo)}
	class="not-prose group my-8 flex items-start gap-4 rounded-xl border border-foreground/10 p-4 no-underline transition-colors hover:border-primary/30 hover:bg-primary/5"
>
	<svg viewBox="0 0 24 24" class="mt-0.5 h-6 w-6 shrink-0 fill-current text-foreground" aria-hidden="true">
		<path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z" />
	</svg>
	<span class="flex min-w-0 flex-col gap-1">
		<span class="flex flex-wrap items-center gap-2">
			<span class="break-all font-semibold text-foreground group-hover:text-primary">{repo}</span>
			{license && (
				<span class="rounded-full border border-foreground/15 px-2 py-0.5 text-xs text-muted-foreground">{license} license</span>
			)}
		</span>
		{description && <span class="text-sm text-foreground/70">{description}</span>}
	</span>
</a>
