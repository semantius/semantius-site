---
/**
 * Markdown and assistant actions, shown as a quiet metadata row under the <h1>.
 *
 * Every affordance here is for a HUMAN reader. Agents already have the twin via
 * <link rel="alternate"> in SEO.astro and via /llms.txt, and never need a
 * button. "View as Markdown" leads because it teaches a convention (append
 * .md), so a reader who learns it once uses it on pages they never visit. Ask
 * is self-contained and teaches nothing.
 *
 * Styling note, because an earlier revision got this wrong: these are NOT
 * buttons. Bordered, filled controls read as primary actions and shout louder
 * than the page title they sit under. This is a metadata row in the idiom
 * Cloudflare's docs use, muted text with small icons and hairline separators,
 * and it stays out of the way until you look for it. Keeping them visually
 * quiet is also what let the menu go: four flat items fit the ~800px content
 * column easily, where four bordered controls did not, so there is no
 * <details> wrapper, no open/close state and no outside-click handling left.
 *
 * Semantics are still real controls: three links and one <button>, each with a
 * visible focus ring. Do not swap the button for an <a>; it performs an action,
 * it does not navigate.
 *
 * The copy action FETCHES the .md at click time rather than inlining it at
 * build time. entry.data.markdownTwin exists and would save the request, but it
 * costs up to 15KB of duplicated content per page and is the pre-composed body
 * without the twin's header and Related footer, so it is not what the .md URL
 * actually serves.
 */
import { toMarkdownPath } from '~/lib/dualmark/paths';
import { hasMarkdownTwin } from '~/lib/dualmark/excluded';

interface Props {
	/** Page path, normally Astro.url.pathname. */
	pathname: string;
	/** Suppress entirely on noindex pages, matching the condition in SEO.astro. */
	noindex?: boolean;
}

const { pathname, noindex = false } = Astro.props;

// Twins are emitted for noindex pages too, so this is about consistency rather
// than a 404: if <head> deliberately does not advertise a twin, the page header
// must not either.
const show = !noindex && hasMarkdownTwin(pathname);

const mdPath = toMarkdownPath(pathname);
const mdUrl = new URL(mdPath, Astro.site).toString();

// Point the assistants at the twin, not the HTML page. That is the whole
// payoff: they read clean markdown instead of parsing our nav, cookie banner
// and hydration scripts.
const prompt = `Read ${mdUrl} and help me with: `;

const itemClass =
	'inline-flex items-center gap-1.5 rounded-sm transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40 focus-visible:ring-offset-2 focus-visible:ring-offset-background';
const iconClass = 'opacity-60';
---

{
	show && (
		<div
			class="not-prose -mt-4 mb-8 flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-foreground/10 pb-4 text-sm text-muted-foreground"
			data-pagefind-ignore
		>
			<a href={mdPath} class={itemClass}>
				<svg
					class={iconClass}
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="2" y="5" width="20" height="14" rx="2" />
					<path d="M6 15V9l3 3 3-3v6" />
					<path d="M17 9v6" />
					<path d="M15 13l2 2 2-2" />
				</svg>
				View as Markdown
			</a>

			<span class="select-none text-foreground/15" aria-hidden="true">
				|
			</span>

			<button type="button" class={`page-actions-copy ${itemClass}`} data-md={mdPath}>
				<svg
					class={iconClass}
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<rect x="9" y="9" width="13" height="13" rx="2" />
					<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1" />
				</svg>
				<span class="page-actions-label">Copy as Markdown</span>
			</button>

			<span class="select-none text-foreground/15" aria-hidden="true">
				|
			</span>

			<a href={`https://claude.ai/new?q=${encodeURIComponent(prompt)}`} target="_blank" rel="noopener noreferrer" class={itemClass}>
				<svg
					class={iconClass}
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
				</svg>
				Ask Claude
			</a>

			<span class="select-none text-foreground/15" aria-hidden="true">
				|
			</span>

			<a href={`https://chatgpt.com/?q=${encodeURIComponent(prompt)}`} target="_blank" rel="noopener noreferrer" class={itemClass}>
				<svg
					class={iconClass}
					width="14"
					height="14"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" />
					<path d="M8 10h8M8 14h5" />
				</svg>
				Ask ChatGPT
			</a>
		</div>
	)
}

<script>
	// Bound to .page-actions-copy, NOT the global .copy-button hook in
	// CopyButton.astro: that one queries every .copy-button on the page and
	// would double-bind anything sharing the class.
	function initPageActions() {
		document
			.querySelectorAll<HTMLButtonElement>('.page-actions-copy')
			.forEach((button) => {
				if (button.dataset.bound) return;
				button.dataset.bound = 'true';

				const label = button.querySelector<HTMLElement>('.page-actions-label');
				const original = label?.textContent ?? 'Copy as Markdown';
				let resetTimer: number | undefined;

				const flash = (text: string) => {
					if (!label) return;
					window.clearTimeout(resetTimer);
					label.textContent = text;
					resetTimer = window.setTimeout(() => {
						label.textContent = original;
					}, 2000);
				};

				button.addEventListener('click', async () => {
					const href = button.dataset.md;
					if (!href) return;
					try {
						// A .md that 404s must never leave the control claiming
						// success. _headers pins Content-Type on .md, so a missing
						// file still answers 404 and res.ok is the only reliable
						// signal here.
						const res = await fetch(href, { headers: { Accept: 'text/markdown' } });
						if (!res.ok) throw new Error(`${res.status} for ${href}`);
						await navigator.clipboard.writeText(await res.text());
						flash('Copied');
					} catch (err) {
						console.error('[page-actions] copy failed:', err);
						flash('Copy failed');
					}
				});
			});
	}

	initPageActions();
	// The site does not use <ClientRouter />, but every other inline script here
	// listens for this anyway, so adding one later cannot silently break them.
	document.addEventListener('astro:page-load', initPageActions);
</script>
