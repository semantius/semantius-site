---
import { ListTree, X } from 'lucide-react';
import NavTree from './NavTree.astro';
import type { NavNode } from '~/lib/docs-tree';

interface CollectionTab {
  slug: string;
  label: string;
  href: string;
  active: boolean;
}

interface Props {
  nodes: NavNode[];
  collections?: CollectionTab[];
  currentPath: string;
}

const { nodes, collections = [], currentPath } = Astro.props;
---

<div data-mobile-docs>
  <button
    type="button"
    data-mobile-docs-open
    class="flex lg:hidden items-center gap-2 px-3 py-1.5 text-sm font-medium text-foreground/70 bg-foreground/5 rounded-full hover:text-foreground transition-colors"
    aria-label="Open Documentation Navigation"
    aria-expanded="false"
    aria-controls="mobile-docs-panel"
  >
    <ListTree className="w-4 h-4" />
    Docs Menu
  </button>

  <div
    data-mobile-docs-backdrop
    class="mobile-docs-backdrop fixed inset-0 bg-background/60 backdrop-blur-sm z-[80]"
    aria-hidden="true"
  />

  <div
    id="mobile-docs-panel"
    data-mobile-docs-panel
    class="mobile-docs-panel fixed inset-y-0 left-0 w-[85%] max-w-sm bg-background border-r border-foreground/10 z-[90] shadow-2xl flex flex-col"
    role="dialog"
    aria-modal="true"
    aria-label="Documentation Navigation"
    inert
  >
    <div class="flex items-center justify-between p-6 border-b border-foreground/5">
      <div class="flex items-center gap-2 font-bold text-lg">
        <ListTree className="w-5 h-5 text-primary" />
        Documentation
      </div>
      <button
        type="button"
        data-mobile-docs-close
        class="p-2 -mr-2 text-foreground/50 hover:text-foreground transition-colors"
        aria-label="Close documentation navigation"
      >
        <X className="w-6 h-6" />
      </button>
    </div>

    {collections.length > 1 && (
      <div class="flex gap-2 px-6 py-4 border-b border-foreground/5">
        {collections.map((c) => (
          <a
            href={c.href}
            class:list={[
              'flex-1 text-center rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
              c.active
                ? 'bg-primary/10 text-primary'
                : 'bg-foreground/5 text-foreground/60 hover:text-foreground',
            ]}
          >
            {c.label}
          </a>
        ))}
      </div>
    )}

    <nav class="flex-1 overflow-y-auto p-6">
      <NavTree nodes={nodes} currentPath={currentPath} />
    </nav>

    <div class="p-6 border-t border-foreground/5 bg-foreground/2">
      <a
        href="/docs/overview"
        class="flex items-center justify-center w-full px-4 py-3 bg-primary text-white rounded-xl font-bold shadow-lg shadow-primary/20 hover:bg-primary/90 transition-all text-sm"
      >
        Quick Start Guide
      </a>
    </div>
  </div>
</div>

<style>
  .mobile-docs-backdrop {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .mobile-docs-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .mobile-docs-panel {
    transform: translateX(-100%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.35s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.2s ease,
      visibility 0.35s;
  }
  .mobile-docs-panel.is-open {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
</style>

<script>
  function initMobileDocs() {
    const root = document.querySelector('[data-mobile-docs]');
    if (!root || root instanceof HTMLElement === false) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const openBtn = root.querySelector('[data-mobile-docs-open]');
    const closeBtn = root.querySelector('[data-mobile-docs-close]');
    const backdrop = root.querySelector('[data-mobile-docs-backdrop]');
    const panel = root.querySelector('[data-mobile-docs-panel]');
    if (!openBtn || !closeBtn || !backdrop || !panel) return;

    const setOpen = (open) => {
      backdrop.classList.toggle('is-open', open);
      panel.classList.toggle('is-open', open);
      openBtn.setAttribute('aria-expanded', String(open));
      panel.toggleAttribute('inert', !open);
      document.body.style.overflow = open ? 'hidden' : 'unset';
    };

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));
    panel.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });
  }

  initMobileDocs();
  document.addEventListener('astro:page-load', initMobileDocs);
</script>
