---
import { Check } from 'lucide-react';
import { SIGN_UP_URL, count, usd, type CloudPlan } from '~/data/pricing';

interface Props {
  plan: CloudPlan;
}

const { plan } = Astro.props;
const available = plan.status === 'available';

const lines = [
  plan.userLimit === null ? 'No limit on users' : `Up to ${plan.userLimit} users, people and agents alike`,
  `Up to ${count(plan.maxComputeUnits)} compute ${plan.maxComputeUnits === 1 ? 'unit' : 'units'}`,
  plan.storageLimit === null ? 'Unlimited data storage, paid in credits' : `Up to ${plan.storageLimit} of data storage`,
  ...(plan.topUps ? ['Top-ups available'] : []),
  ...(plan.webhookReceivers ? ['Webhook receivers'] : []),
  plan.support === 'Support' ? 'Support' : `Support: ${plan.support.toLowerCase()}`,
];
---

<article class="flex flex-col rounded-3xl border border-foreground/10 bg-foreground/2 p-8">
  <div class="flex items-center justify-between gap-3 mb-2">
    <h3 class="text-xl font-bold">{plan.name}</h3>
    {!available && (
      <span class="rounded-full border border-primary/30 bg-primary/10 px-2.5 py-0.5 text-xs font-semibold text-primary whitespace-nowrap">Coming soon</span>
    )}
  </div>
  <p class="text-sm text-muted-foreground mb-6 md:min-h-10">{plan.summary}</p>

  {/* Both periods are in the HTML, so the markdown twin and search carry both;
      the billing toggle on the page decides which one is displayed. */}
  <div class="mb-8 min-h-16">
    <p class="flex items-baseline gap-2" data-period={plan.yearlyPrice === null ? undefined : 'monthly'}>
      <span class="text-4xl font-display font-bold">{usd(plan.monthlyPrice)}</span>
      <span class="text-muted-foreground">per month</span>
    </p>
    {plan.yearlyPrice !== null && (
      <div data-period="yearly">
        <p class="flex items-baseline gap-2">
          <span class="text-4xl font-display font-bold">{usd(plan.yearlyPrice)}</span>
          <span class="text-muted-foreground">per month, billed yearly</span>
        </p>
        <p class="mt-1 text-sm text-muted-foreground">{usd(plan.yearlyPrice * 12)} paid upfront for 12 months</p>
      </div>
    )}
  </div>

  <ul class="space-y-3 mb-8 flex-1 text-sm">
    <li class="flex gap-3 font-medium">
      <Check className="w-4 h-4 mt-0.5 text-primary shrink-0" aria-hidden="true" />
      <span>{count(plan.credits)} credits each month</span>
    </li>
    {lines.map((line) => (
      <li class="flex gap-3 text-muted-foreground">
        <Check className="w-4 h-4 mt-0.5 text-primary shrink-0" aria-hidden="true" />
        <span>{line}</span>
      </li>
    ))}
  </ul>

  {/* An available plan signs up in the app. A coming-soon plan offers the
      wait list, the same overlay the header's Sign up button opens. */}
  <a
    href={available ? SIGN_UP_URL : '#signup'}
    data-plan={plan.key}
    data-pagefind-ignore
    class={`pricing-plan-cta block w-full rounded-xl px-6 py-3 text-center font-medium transition-colors ${
      available
        ? 'bg-primary text-white hover:bg-primary/90'
        : 'border border-foreground/15 hover:bg-foreground/5'
    }`}
  >
    {available ? 'Sign up' : 'Join the wait list'}
  </a>
</article>
