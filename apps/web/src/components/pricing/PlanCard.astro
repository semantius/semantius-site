---
import { Check } from 'lucide-react';
import Tbd from './Tbd.astro';
import PricingCell from './PricingCell.astro';
import { count, isPending, usd, type CloudPlan } from '~/data/pricing';

interface Props {
  plan: CloudPlan;
}

const { plan } = Astro.props;

const lines = [
  plan.userLimit === null ? 'No limit on users' : `Up to ${plan.userLimit} users, people and agents alike`,
  `Up to ${count(plan.maxComputeUnits)} compute ${plan.maxComputeUnits === 1 ? 'unit' : 'units'}`,
  plan.storageLimit === null ? 'Unlimited data storage, paid in credits' : `Up to ${plan.storageLimit} of data storage`,
  ...(plan.topUps ? ['Top-ups available'] : []),
  ...(plan.webhookReceivers ? ['Webhook receivers'] : []),
];
const support = typeof plan.support === 'string' ? `Support: ${plan.support.toLowerCase()}` : plan.support;
---

<article class="flex flex-col rounded-3xl border border-foreground/10 bg-foreground/2 p-8">
  <h3 class="text-xl font-bold mb-2">{plan.name}</h3>
  <p class="text-sm text-muted-foreground mb-6">{plan.summary}</p>

  {/* Both periods are in the HTML, so the markdown twin and search carry both;
      the billing toggle on the page decides which one is displayed. */}
  <div class="mb-8 min-h-12">
    <p class="flex items-baseline gap-2" data-period={plan.yearlyPrice === null ? undefined : 'monthly'}>
      <span class="text-4xl font-display font-bold">{usd(plan.monthlyPrice)}</span>
      <span class="text-muted-foreground">per month</span>
    </p>
    {plan.yearlyPrice !== null && (
      <p class="flex items-baseline gap-2" data-period="yearly">
        <span class="text-4xl font-display font-bold">
          {isPending(plan.yearlyPrice) ? <Tbd note={plan.yearlyPrice.tbd} /> : usd(plan.yearlyPrice)}
        </span>
        <span class="text-muted-foreground">per year, paid upfront</span>
      </p>
    )}
  </div>

  <ul class="space-y-3 mb-8 flex-1 text-sm">
    <li class="flex gap-3 font-medium">
      <Check className="w-4 h-4 mt-0.5 text-primary shrink-0" aria-hidden="true" />
      <span>{isPending(plan.credits) ? <><Tbd note={plan.credits.tbd} /> credits each month</> : `${count(plan.credits)} credits each month`}</span>
    </li>
    {lines.map((line) => (
      <li class="flex gap-3 text-muted-foreground">
        <Check className="w-4 h-4 mt-0.5 text-primary shrink-0" aria-hidden="true" />
        <span>{line}</span>
      </li>
    ))}
    <li class="flex gap-3 text-muted-foreground">
      <Check className="w-4 h-4 mt-0.5 text-primary shrink-0" aria-hidden="true" />
      <PricingCell value={support} />
    </li>
  </ul>

  {/* The cloud opens through the wait list until the public beta, the same
      overlay the header's Sign up button and the announcement banner open.
      No query parameters: the app's sign-up page reads none of them. */}
  <a
    href="#signup"
    data-plan={plan.key}
    data-pagefind-ignore
    class="pricing-plan-cta block w-full rounded-xl px-6 py-3 text-center font-medium transition-colors bg-primary text-white hover:bg-primary/90"
  >
    Join the wait list
  </a>
</article>
