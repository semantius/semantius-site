---
// The footer from the founder's v1 specification (§4.11), on every page, with
// Privacy and Terms added (home-deviations.md, 3).
import { getCollection } from 'astro:content';
import { ACTION_LINKS, FOOTER_LINKS } from '~/site.config';
import { blogPath } from '~/lib/routes';
import { Github } from 'lucide-react';
import ThemeToggle from '~/components/common/ThemeToggle.astro';
import Tbd from '~/components/common/Tbd.astro';

// An article's title links to its blog post, and a title whose post is not
// published is not shown (§4.11). A post is matched by its exact title.
const ARTICLE_GROUPS = [
  {
    title: 'Agent safety and architecture',
    articles: ['Rules in a prompt versus rules in Postgres: what your agent actually follows'],
  },
  {
    title: 'Agents and connected data',
    articles: [
      "Why your agent can't connect a ticket to usage and lead status, and what fixes it",
      'What Klarna actually did: unify first, and fewer tools follow',
    ],
  },
];

const posts = await getCollection('blog');
const groups = ARTICLE_GROUPS.map((g) => ({
  title: g.title,
  links: g.articles.flatMap((title) => {
    const post = posts.find((p) => p.data.title === title);
    return post ? [{ href: blogPath(post), label: title }] : [];
  }),
}));

const github = ACTION_LINKS.social.github;
const link = 'hover:text-foreground transition-colors';
---

<footer class="mt-auto border-t border-foreground/10 bg-background py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid gap-8 md:grid-cols-3 mb-12">
      {groups.map((g) => (
        <div>
          <h3 class="font-semibold mb-4 text-foreground">{g.title}</h3>
          {g.links.length > 0 ? (
            <ul class="space-y-2 text-sm text-foreground/80">
              {g.links.map((l) => <li><a href={l.href} class={link}>{l.label}</a></li>)}
            </ul>
          ) : (
            <Tbd note="No article in this group is published yet." />
          )}
        </div>
      ))}
      <div>
        <h3 class="font-semibold mb-4 text-foreground">For agents and developers</h3>
        <ul class="space-y-2 text-sm text-foreground/80">
          <li><a href="/llms.txt" class={link}>llms.txt</a></li>
          <li>Docs quickstart <Tbd note="No docs quickstart page exists." /></li>
          <li><a href={github} class={link}>GitHub</a></li>
          <li><a href="https://github.com/semantius/awesome-agent-first" class={link}>The agent-first definition and list</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-foreground/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-muted-foreground text-sm flex flex-wrap items-center gap-x-6 gap-y-2">
        <span>© Semantius by <a href="/about" class={link}>adenin</a>.</span>
        {FOOTER_LINKS.legal.links.map((l) => <a href={l.href} class={link}>{l.label}</a>)}
      </div>

      <div class="flex items-center gap-4">
        <ThemeToggle />
        <a href={github} target="_blank" rel="noopener noreferrer" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="GitHub">
          <Github className="w-5 h-5" strokeWidth={1.5} />
        </a>
      </div>
    </div>
  </div>
</footer>
