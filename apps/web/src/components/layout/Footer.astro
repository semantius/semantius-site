---
// The footer of change request 1 (§8), on every page, with Privacy and Terms
// added (home-deviations.md, 3).
import { getCollection } from 'astro:content';
import { ACTION_LINKS, FOOTER_LINKS } from '~/site.config';
import { blogPath } from '~/lib/routes';
import { Github } from 'lucide-react';
import ThemeToggle from '~/components/common/ThemeToggle.astro';
import Tbd from '~/components/common/Tbd.astro';

// Each title links to its blog post once it is published, and shows with a TBD
// until then (change request 1, §8). A post is matched by its exact title.
const ARTICLE_GROUPS = [
  {
    title: 'Agent Safety & Architecture',
    articles: [
      'How to build approval rules for AI agents with JSONLogic inside PostgreSQL',
      'Rules in a prompt versus rules in Postgres: what your agent actually follows',
    ],
  },
  {
    title: 'Database-Driven Minimalism',
    articles: [
      "Why your agent can't connect a ticket to usage and lead status, and what fixes it",
      'What Klarna actually did: unify first, and fewer tools follow',
    ],
  },
];

const posts = await getCollection('blog');
const groups = ARTICLE_GROUPS.map((g) => ({
  title: g.title,
  articles: g.articles.map((title) => {
    const post = posts.find((p) => p.data.title === title);
    return { label: title, href: post ? blogPath(post) : undefined };
  }),
}));

const github = ACTION_LINKS.social.github;
const awesomeAgentFirst = 'https://github.com/semantius/awesome-agent-first';
const iconLink = 'text-muted-foreground hover:text-foreground transition-colors';
const link = 'hover:text-foreground transition-colors';
---

<footer class="mt-auto border-t border-foreground/10 bg-background py-12">
  <div class="max-w-7xl mx-auto px-6">
    <div class="grid gap-8 md:grid-cols-3 mb-12">
      {groups.map((g) => (
        <div>
          <h3 class="font-semibold mb-4 text-foreground">{g.title}</h3>
          <ul class="space-y-3 text-sm text-foreground/80">
            {g.articles.map((a) => (
              <li>
                {a.href ? <a href={a.href} class={link}>{a.label}</a> : <>{a.label} <Tbd note="Not published yet." /></>}
              </li>
            ))}
          </ul>
        </div>
      ))}
      <div>
        <h3 class="font-semibold mb-4 text-foreground">System Access Nodes</h3>
        <ul class="space-y-2 text-sm text-foreground/80">
          <li><a href="/llms.txt" class={link}>llms.txt</a></li>
          <li><a href="/docs/overview" class={link}>Docs</a></li>
          <li><a href={github} class={link}>GitHub</a></li>
          <li><a href={awesomeAgentFirst} class={link}>The agent-first definition and list</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-foreground/10 flex flex-col md:flex-row justify-between items-center gap-4">
      <div class="text-muted-foreground text-sm flex flex-wrap items-center gap-x-6 gap-y-2">
        <span>© Semantius by <a href="/about" class={link}>adenin</a>.</span>
        {FOOTER_LINKS.legal.links.map((l) => <a href={l.href} class={link}>{l.label}</a>)}
      </div>

      <div class="flex items-center gap-4">
        <ThemeToggle />
        <a
          href={awesomeAgentFirst}
          target="_blank"
          rel="noopener noreferrer"
          class={iconLink}
          aria-label="Awesome Agent First Software"
          title="Awesome Agent First Software"
        >
          {/* Awesome Lists mark (Simple Icons via dashboardicons.com/icons/external/awesomelists). fill currentColor so it tracks the theme the same way the GitHub icon does. */}
          <svg
            class="w-5 h-5"
            fill="currentColor"
            role="img"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            aria-hidden="true"
          >
            <path d="M24 11.438l-6.154-5.645-.865.944 5.128 4.7H1.895l5.128-4.705-.865-.943-6.154 5.649H0v3.72c0 1.683 1.62 3.053 3.61 3.053h3.795c1.99 0 3.61-1.37 3.61-3.051v-2.446h1.97v2.446c0 1.68 1.62 3.051 3.61 3.051h3.794c1.99 0 3.61-1.37 3.61-3.051v-3.721z"></path>
          </svg>
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer" class={iconLink} aria-label="GitHub">
          <Github className="w-5 h-5" strokeWidth={1.5} />
        </a>
      </div>
    </div>
  </div>
</footer>
