---
import { twMerge } from 'tailwind-merge';
import clsx from 'clsx';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* The opening of a page (back link, badge, title, intro or hero). It owns the space
    below the SiteHeader, so pages never pad for the site header themselves. The space
    is padding inside this element, so a background set here runs up to the SiteHeader. */}
<header class={twMerge(clsx('pt-16 md:pt-20', className))}>
  <slot />
</header>
