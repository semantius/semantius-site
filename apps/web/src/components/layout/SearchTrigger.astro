---
import { Search as SearchIcon } from 'lucide-react';

interface Props {
  placeholder?: string;
  devModalLabels?: {
    title?: string;
    description?: string;
    gotIt?: string;
    doc?: string;
  };
}

const { placeholder = 'Search...', devModalLabels = {} } = Astro.props;
---

<button
  type="button"
  id="search-trigger"
  data-placeholder={placeholder}
  data-dev-labels={JSON.stringify(devModalLabels)}
  aria-label={placeholder}
  aria-expanded="false"
  aria-haspopup="dialog"
  class="flex items-center gap-2 px-3 py-1.5 text-sm text-foreground/60 hover:text-foreground bg-foreground/5 hover:bg-foreground/10 border border-foreground/10 rounded-full transition-all hover:scale-105"
>
  <SearchIcon size={14} />
  <span class="hidden lg:inline">{placeholder}</span>
  <div class="hidden lg:flex items-center gap-0.5 px-1.5 py-0.5 bg-background border border-foreground/10 rounded-full text-[10px] font-mono shadow-sm">
    <span class="text-[10px] text-foreground/90">⌘K</span>
  </div>
</button>

<script>
  const button = document.getElementById('search-trigger');
  if (button) {
    const props = {
      placeholder: button.getAttribute('data-placeholder') || 'Search...',
      devModalLabels: JSON.parse(button.getAttribute('data-dev-labels') || '{}'),
    };

    let mod = null;
    let isOpen = false;

    async function load() {
      if (!mod) {
        mod = await import('../islands/search-mount.js');
        mod.subscribe((open) => {
          isOpen = open;
          button.setAttribute('aria-expanded', String(open));
        });
      }
      return mod;
    }

    button.addEventListener('click', async () => {
      const m = await load();
      m.openSearch(props, 'button');
    });

    document.addEventListener('keydown', async (e) => {
      if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
        e.preventDefault();
        const m = await load();
        if (isOpen) m.close();
        else m.openSearch(props, 'keyboard');
      }
    });
  }
</script>
