---
interface Props {
  triggerLabel?: string;
  waitlistKey?: string;
}

const { triggerLabel = 'Sign up', waitlistKey = '' } = Astro.props;
---

<button
  type="button"
  id="signup-trigger"
  class="hidden md:block px-4 py-2 text-sm font-medium bg-primary text-white rounded-full hover:bg-primary/90 transition-all cursor-pointer"
>
  {triggerLabel}
</button>
{/* Waitlister embed.js injects an iframe into any element with data-waitlist-key,
    so the key lives in this JSON blob rather than on the button. */}
<script is:inline type="application/json" id="signup-config" set:html={JSON.stringify({ waitlistKey })}></script>

<script>
  const button = document.getElementById('signup-trigger');
  const configEl = document.getElementById('signup-config');
  let waitlistKey = '';
  try {
    waitlistKey = JSON.parse(configEl?.textContent || '{}').waitlistKey || '';
  } catch {
    waitlistKey = '';
  }
  const props = { waitlistKey };

  let mod = null;

  async function load() {
    if (!mod) {
      mod = await import('../islands/signup-mount.js');
    }
    return mod;
  }

  async function open(trigger) {
    const m = await load();
    m.openModal(props, trigger);
  }

  if (button) {
    button.addEventListener('click', () => open('button'));
  }

  if (window.location.hash === '#signup') {
    open('hash');
  }

  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#signup') open('hash');
  });
</script>
