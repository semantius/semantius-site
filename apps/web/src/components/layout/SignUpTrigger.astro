---
// The header's Sign up link, which goes to the same sign-up page as "Start
// free" (change request 1, §9), plus the wait list overlay. The overlay no
// longer has a button of its own: it opens on any "#signup" link, which the
// announcement banner and /pricing's coming-soon plans use.
import { SIGN_UP_URL } from '~/data/pricing';

interface Props {
  triggerLabel?: string;
  waitlistKey?: string;
}

const { triggerLabel = 'Sign up', waitlistKey = '' } = Astro.props;
---

<a
  href={SIGN_UP_URL}
  class="hidden md:block px-4 py-2 text-sm font-medium bg-primary text-white rounded-full hover:bg-primary/90 transition-all"
>
  {triggerLabel}
</a>
{/* Waitlister embed.js injects an iframe into any element with data-waitlist-key,
    so the key lives in this JSON blob rather than on an element. */}
<script is:inline type="application/json" id="signup-config" set:html={JSON.stringify({ waitlistKey })}></script>

<script>
  const configEl = document.getElementById('signup-config');
  let waitlistKey = '';
  try {
    waitlistKey = JSON.parse(configEl?.textContent || '{}').waitlistKey || '';
  } catch {
    waitlistKey = '';
  }
  const props = { waitlistKey };

  let mod = null;

  async function load() {
    if (!mod) {
      mod = await import('../islands/signup-mount.js');
    }
    return mod;
  }

  async function open(trigger) {
    const m = await load();
    m.openModal(props, trigger);
  }

  if (window.location.hash === '#signup') {
    open('hash');
  }

  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#signup') open('hash');
  });
</script>
