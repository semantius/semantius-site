---
import { toMarkdownPath } from '~/lib/dualmark/paths';
import { hasMarkdownTwin } from '~/lib/dualmark/excluded';
interface Props {
  title: string;
  description: string;
  image?: string;
  article?: boolean;
  noindex?: boolean;
  nofollow?: boolean;
}

const { title, description, image, article = false, noindex = false, nofollow = false } = Astro.props;
import { siteConfig } from '~/site.config';
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

// Markdown twin discovery. Every page is also published as agent-facing
// markdown at <page-url>.md, and this link is how a crawler finds it without
// guessing. Canonical pathnames are slash-less ("/about"), so appending ".md"
// is the whole convention; toMarkdownPath still strips a slash defensively.
//
// Skipped when the page has no twin (the 404, the /blueprints/page/N stubs) and
// when it is noindex, so we never advertise a file that is not emitted.
const twinURL =
    hasMarkdownTwin(Astro.url.pathname) && !noindex
        ? new URL(toMarkdownPath(Astro.url.pathname), Astro.site).toString()
        : undefined;

const ogImageUrl = image || siteConfig.ogImage;

const robots = [
  noindex ? 'noindex' : 'index',
  nofollow ? 'nofollow' : 'follow'
].join(', ');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" href={siteConfig.logo.src} />
<link rel="apple-touch-icon" href={siteConfig.logo.src} />
<meta name="generator" content={Astro.generator} />

<!-- Robots -->
<meta name="robots" content={robots} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{twinURL && <link rel="alternate" type="text/markdown" href={twinURL} />}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} data-pagefind-meta="description[content]" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:url" content={Astro.url.toString()} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(ogImageUrl, Astro.url).toString()} />
<meta property="og:logo" content={new URL(siteConfig.logo.src, Astro.url).toString()} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url.toString()} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(ogImageUrl, Astro.url).toString()} />
