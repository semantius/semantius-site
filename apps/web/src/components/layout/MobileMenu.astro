---
import { Github, Menu, X } from 'lucide-react';
import { ACTION_LINKS } from '~/site.config';
import { getNavIcon } from '~/lib/nav-icons';

interface NavChild {
  href: string;
  label: string;
  icon?: string;
}

interface NavLink {
  href?: string;
  label: string;
  children?: NavChild[];
}

interface Labels {
  menu: string;
  getStarted: string;
  signIn: string;
  signInHref: string;
}

interface Props {
  links: NavLink[];
  currentPath?: string;
  labels: Labels;
}

const {
  links,
  currentPath = '/',
  labels,
} = Astro.props;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<div data-mobile-menu>
  <button
    type="button"
    data-mobile-menu-open
    class="p-2 text-foreground hover:bg-foreground/5 rounded-md transition-colors z-50 relative"
    aria-label="Open Mobile Menu"
    aria-expanded="false"
    aria-controls="mobile-menu-panel"
  >
    <Menu className="w-6 h-6" aria-hidden="true" />
  </button>

  <div
    data-mobile-menu-backdrop
    class="mobile-menu-backdrop fixed inset-0 bg-background/60 backdrop-blur-sm z-[60]"
    aria-hidden="true"
  />

  <div
    id="mobile-menu-panel"
    data-mobile-menu-panel
    class="mobile-menu-panel fixed inset-0 md:inset-auto md:top-0 md:right-0 md:h-full md:w-96 bg-background md:border-l md:border-foreground/10 md:shadow-2xl z-[70] p-6 flex flex-col h-[100dvh] md:h-full"
    role="dialog"
    aria-modal="true"
    aria-label="Mobile Navigation"
    inert
  >
    <div class="flex justify-between items-center mb-6">
      <span class="text-2xl font-bold text-primary md:text-lg">{labels.menu}</span>
      <button
        type="button"
        data-mobile-menu-close
        class="p-2 text-foreground/70 hover:text-foreground rounded-full hover:bg-foreground/5 transition-colors"
        aria-label="Close Mobile Menu"
      >
        <X className="w-8 h-8 md:w-6 md:h-6" aria-hidden="true" />
      </button>
    </div>

    <nav class="flex-1 min-h-0 overflow-y-auto" aria-label="Mobile Menu Links">
      <ul class="flex flex-col gap-4 md:gap-2 m-0 p-0 list-none">
        {links.map((link) => {
          const isLinkActive =
            isActive(link.href || '') ||
            (link.children && link.children.some((c) => isActive(c.href)));

          return (
            <li>
              {link.children ? (
                <div class="flex flex-col">
                  <div
                    class:list={[
                      'flex items-center justify-between py-2 text-xl md:text-lg font-bold',
                      isLinkActive
                        ? 'text-primary dark:text-blue-300'
                        : 'text-foreground/80 dark:text-white',
                    ]}
                  >
                    {link.label}
                  </div>
                  <ul class="pl-4 flex flex-col gap-3 md:gap-2 border-l-2 border-foreground/10 ml-2 m-0 list-none">
                    {link.children.map((child) => {
                      const Icon = getNavIcon(child.icon);
                      return (
                        <li>
                          <a
                            href={child.href}
                            class:list={[
                              'py-2 text-lg md:text-base transition-colors flex items-center gap-3',
                              isActive(child.href)
                                ? 'text-primary dark:text-blue-300 font-medium'
                                : 'text-foreground hover:text-primary dark:text-white dark:hover:text-blue-300',
                            ]}
                          >
                            {Icon && <Icon className="w-5 h-5 md:w-4 md:h-4" aria-hidden="true" />}
                            {child.label}
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </div>
              ) : (
                <a
                  href={link.href}
                  class:list={[
                    'flex items-center justify-between py-2 text-xl md:text-lg font-bold transition-colors',
                    isActive(link.href || '')
                      ? 'text-primary dark:text-blue-300'
                      : 'text-foreground hover:text-primary dark:text-white dark:hover:text-blue-300',
                  ]}
                >
                  {link.label}
                </a>
              )}
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="pt-6 md:pt-8 border-t border-foreground/10 flex flex-col gap-4 mt-auto">
      <a
        href={ACTION_LINKS.primary.href}
        class="w-full py-3 px-4 bg-primary text-white text-center font-semibold rounded-lg hover:bg-primary/90 transition-all shadow-lg hover:shadow-primary/25"
      >
        {labels.getStarted}
      </a>
      <a
        href={labels.signInHref || ACTION_LINKS.signIn?.href}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full py-3 px-4 border border-foreground/20 text-foreground text-center font-semibold rounded-lg hover:bg-foreground/5 transition-all"
      >
        {labels.signIn || 'Sign in'}
      </a>

      <div class="flex justify-center gap-6 mt-4">
        <a
          href={ACTION_LINKS.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-foreground/70 hover:text-primary transition-colors"
          aria-label="GitHub"
        >
          <Github className="w-6 h-6" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-menu-backdrop {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }
  .mobile-menu-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
  .mobile-menu-panel {
    transform: translateX(100%);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition:
      transform 0.35s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.2s ease,
      visibility 0.35s;
  }
  .mobile-menu-panel.is-open {
    transform: translateX(0);
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }
</style>

<script>
  function initMobileMenu() {
    const root = document.querySelector('[data-mobile-menu]');
    if (!root || root instanceof HTMLElement === false) return;
    if (root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const openBtn = root.querySelector('[data-mobile-menu-open]');
    const closeBtn = root.querySelector('[data-mobile-menu-close]');
    const backdrop = root.querySelector('[data-mobile-menu-backdrop]');
    const panel = root.querySelector('[data-mobile-menu-panel]');
    if (!openBtn || !closeBtn || !backdrop || !panel) return;

    const setOpen = (open) => {
      backdrop.classList.toggle('is-open', open);
      panel.classList.toggle('is-open', open);
      openBtn.setAttribute('aria-expanded', String(open));
      panel.toggleAttribute('inert', !open);
      document.body.style.overflow = open ? 'hidden' : 'unset';
    };

    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    backdrop.addEventListener('click', () => setOpen(false));
    panel.querySelectorAll('a').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });
  }

  initMobileMenu();
  document.addEventListener('astro:page-load', initMobileMenu);
</script>
