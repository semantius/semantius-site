---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/ui/Container.astro';
import Button from '~/components/ui/Button.astro';
import CopyText from '~/components/common/CopyText.astro';
import DocsLinks from '~/components/sections/DocsLinks.astro';
import CrossLinks from '~/components/sections/CrossLinks.astro';
import { SIGN_UP_URL } from '~/data/pricing';
import { SOLUTIONS } from '~/data/solutions';
import { promptPath, samplePrompt } from '~/data/sample-prompts';

// The founder's v1 specification, §6, with the copy as given.
// Departures: home-deviations.md. Open gaps: home-tbd.md.

const page = SOLUTIONS.crm;
const agency = samplePrompt('agency-client-tracker');

const connections = [
    ['Software company', "A support ticket ↔ the customer's product usage ↔ the open deal"],
    ['Manufacturer', "A warranty claim ↔ the machine's service history ↔ the open order"],
    ['Field service', 'A service call ↔ the maintenance contract ↔ the open quote'],
    ['Agency', 'A client request ↔ the hours on the project ↔ the retainer'],
];

const forIt = [
    'Every agent your staff bring meets the same rules',
    'Who changed what, and when',
    'Spending is limited to the credits you hold, with no surprise charges',
    'People sign in with their Microsoft 365 or Google account',
    'Backups in the cloud, with point-in-time restore coming soon',
];

const h2 = 'text-3xl md:text-4xl font-display font-bold mb-6';
const prose = 'text-lg text-foreground/75 leading-relaxed';
const link = 'font-medium text-primary underline-offset-4 hover:underline';
---

<Layout
    title="Build your CRM with your AI agent, no per-seat bill | Semantius"
    breadcrumbs={[{ name: 'Home', href: '/' }, { name: page.name, href: page.path }]}
>
    <section class="pt-44 pb-12 md:pt-40">
        <Container class="max-w-4xl">
            <h1 class="text-4xl md:text-6xl font-bold tracking-tight">Sales, support and delivery in one model, so your agent can connect the ticket, the usage and the deal.</h1>
            <p class="mt-6 text-xl text-foreground/75 leading-relaxed">Your agent builds it from a description. Whatever agent your staff bring meets the same rules, and every change is logged. No per-seat bill, and no sync pipeline to keep alive.</p>
        </Container>
    </section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>The connection, by type of business</h2>
            <div class="relative overflow-x-auto rounded-2xl border border-foreground/10">
                <table class="w-full text-left text-sm md:text-base">
                    <thead>
                        <tr class="border-b border-foreground/10 bg-foreground/2">
                            <th scope="col" class="p-4 font-semibold">Business</th>
                            <th scope="col" class="p-4 font-semibold">What the agent connects</th>
                        </tr>
                    </thead>
                    <tbody>
                        {connections.map(([business, connects]) => (
                            <tr class="border-b border-foreground/10 last:border-b-0">
                                <th scope="row" class="p-4 align-top font-semibold whitespace-nowrap">{business}</th>
                                <td class="p-4 text-foreground/80">{connects}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>Getting data in</h2>
            <p class={prose}>At the start, your agent imports your existing data, for example CSV exports from your CRM, help desk or spreadsheets. Incoming webhooks (Pro) then keep it current in real time.</p>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>Fewer tools</h2>
            <p class={prose}>Once sales, support and delivery share one model, many teams find they need fewer tools.</p>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>Approvals</h2>
            <p class={prose}>Purchase requests, quotes and client sign-offs move only through the steps you set, and only the right person can move them on.</p>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>For IT</h2>
            <ul class="list-disc pl-5 space-y-2 text-lg text-foreground/80">
                {forIt.map((item) => <li>{item}</li>)}
            </ul>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>Examples</h2>
            <ul class="list-disc pl-5 space-y-2 text-lg text-foreground/80">
                <li><a href={promptPath('purchase-approvals')} class={link}>Purchase approvals</a> and <a href={promptPath('equipment-register')} class={link}>an equipment register</a></li>
                <li><a href={promptPath('field-service-jobs')} class={link}>Jobs, crews and maintenance contracts</a></li>
                <li><a href={promptPath('agency-client-tracker')} class={link}>Clients, projects, deadlines and approvals</a></li>
            </ul>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl space-y-8">
            <DocsLinks links={[
                { label: 'The agency sample prompt', href: promptPath(agency.slug) },
                { label: 'Importing data' },
                { label: 'Approval steps' },
            ]} />
            <CrossLinks current="crm" />
            <div class="flex flex-col sm:flex-row gap-4">
                <CopyText variant="primary" text={agency.prompt} label="Build your CRM with your agent" />
                <Button href={SIGN_UP_URL} variant="outline" size="lg" class="rounded-full">Start free</Button>
            </div>
        </Container>
    </Section>
</Layout>
