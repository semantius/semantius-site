---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Section from '~/components/layout/Section.astro';
import Container from '~/components/ui/Container.astro';
import Button from '~/components/ui/Button.astro';
import DocsLinks from '~/components/sections/DocsLinks.astro';
import CrossLinks from '~/components/sections/CrossLinks.astro';
import { SIGN_UP_URL } from '~/data/pricing';
import { SOLUTIONS } from '~/data/solutions';

// The founder's v1 specification, §7, with the copy as given.
// Departures: home-deviations.md. Open gaps: home-tbd.md.

const page = SOLUTIONS.apps;

const whatYouGet = [
    'Design the model with your agent',
    'The API and the app are generated together',
    'Per-view overrides and your own branding',
];

const forBuilders = [
    'One account manages several independent, self-contained data platforms, one per client',
    "Export a module and import it into the client's production or server",
    'Hand-over under MIT',
    'Self-hosting on Dokploy',
    "The client's own identity provider",
];

const h2 = 'text-3xl md:text-4xl font-display font-bold mb-6';
---

<Layout
    title="Open-source Airtable alternative on Postgres, app included | Semantius"
    breadcrumbs={[{ name: 'Home', href: '/' }, { name: page.name, href: page.path }]}
>
    <section class="pt-44 pb-12 md:pt-40">
        <Container class="max-w-4xl">
            <h1 class="text-4xl md:text-6xl font-bold tracking-tight">Day 30, not day 1.</h1>
            <p class="mt-6 text-2xl font-semibold leading-snug">Your Airtable base, with real relationships, a login for each person, and a price that doesn't grow per seat.</p>
            <p class="mt-5 text-xl text-foreground/75 leading-relaxed">Any tool can build an app on day one. When the business changes, your agent changes the model, and the API and the app follow, with no frontend code to maintain.</p>
        </Container>
    </section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>What you get</h2>
            <ul class="list-disc pl-5 space-y-2 text-lg text-foreground/80">
                {whatYouGet.map((item) => <li>{item}</li>)}
            </ul>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl">
            <h2 class={h2}>For builders</h2>
            <ul class="list-disc pl-5 space-y-2 text-lg text-foreground/80">
                {forBuilders.map((item) => <li>{item}</li>)}
            </ul>
        </Container>
    </Section>

    <Section class="py-12!">
        <Container class="max-w-4xl space-y-8">
            <DocsLinks links={[
                { label: 'Customizing the app' },
                { label: 'Module export' },
                { label: 'Self-hosting', href: '/docs/self-hosted' },
            ]} />
            <CrossLinks current="apps" />
            <div class="flex flex-col sm:flex-row gap-4">
                <Button href={SIGN_UP_URL} size="lg" class="rounded-full">Build an app</Button>
                <Button href="/docs/self-hosted/dokploy" variant="outline" size="lg" class="rounded-full">Self-host with Dokploy</Button>
            </div>
        </Container>
    </Section>
</Layout>
