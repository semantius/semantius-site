---
export const prerender = true;
import { ChevronDown } from 'lucide-react';
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import Command from '~/components/common/Command.astro';
import { TEMPLATE_GROUPS, TEMPLATES_PATH } from '~/data/templates';

// Layout loosely follows Airtable's template gallery: a sidebar of categories
// beside every category's prompts, all on one page. Sidebar links jump to the
// category's anchor.
---

<Layout
	title="Templates"
	breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Templates', href: TEMPLATES_PATH }]}
>
	<PageHeader class="pb-10">
		<Container>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight">Templates</h1>
		</Container>
	</PageHeader>
	<section class="pb-24">
		<Container class="grid gap-10 lg:grid-cols-[260px_1fr] lg:gap-12">
			<aside aria-label="Template categories" class="lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto">
				{TEMPLATE_GROUPS.map((g) => (
					<details open class="group mb-6">
						<summary class="flex cursor-pointer list-none items-center justify-between py-2 text-sm font-semibold text-foreground/60 [&::-webkit-details-marker]:hidden">
							{g.label}
							<ChevronDown className="h-4 w-4 transition-transform group-open:rotate-180" aria-hidden="true" />
						</summary>
						<ul class="mt-2 space-y-1">
							{g.categories.map((c) => (
								<li><a href={`#${c.id}`} class="block py-1 text-foreground/90 hover:text-primary">{c.name}</a></li>
							))}
						</ul>
					</details>
				))}
			</aside>
			<div class="min-w-0 space-y-16">
				{TEMPLATE_GROUPS.flatMap((g) => g.categories).map((c) => (
					<section aria-labelledby={c.id}>
						<h2 id={c.id} class="scroll-mt-24 text-2xl md:text-3xl font-bold tracking-tight mb-6">{c.name}</h2>
						<ul class="grid gap-6 md:grid-cols-2">
							{c.templates.map((t) => (
								<li class="flex flex-col p-6 rounded-3xl bg-foreground/2 border border-foreground/10">
									<h3 class="text-lg font-bold mb-4">{t.title}</h3>
									<Command mode="chat" runnable command={t.prompt} />
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</Container>
	</section>
</Layout>
