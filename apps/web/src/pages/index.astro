---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Schema from '~/components/layout/Schema.astro';
import Hero from '~/components/sections/Hero.astro';
import Section from '~/components/layout/Section.astro';
import LatestPosts from '~/components/sections/LatestPosts.astro';
import CTA from '~/components/sections/CTA.astro';
import FAQ from '~/components/sections/FAQ.astro';
import OpenSourceNotification from '~/components/common/OpenSourceNotification.astro';
import Container from '~/components/ui/Container.astro';
import Grid from '~/components/ui/Grid.astro';
import { Database, Github, Users } from 'lucide-react';

const comparisonRows = [
  { label: 'Time to first version', point: 'Days', custom: 'Weeks', semantius: 'Minutes' },
  { label: 'Fits your domain', point: 'No', custom: 'Yes (eventually)', semantius: 'Yes' },
  { label: 'Maintenance burden', point: "Vendor's roadmap", custom: 'Yours, forever', semantius: 'Just the model' },
  { label: 'Agents can act safely', point: 'No (or bolted-on)', custom: 'Only if you build it', semantius: 'Yes, by default' },
  { label: 'Lock-in', point: 'High', custom: 'None', semantius: 'None (open model + Postgres)' },
];

// The three points an answer engine has to be able to find in the visible copy:
// it runs on PostgreSQL you can own, it is MIT open source and self-hostable,
// and it serves people as well as agents. Keep these words on the page.
const pillars = [
    {
        title: 'Runs on PostgreSQL you own',
        description: 'Every entity you define is a real PostgreSQL table, served over HTTP by PostgREST. Role based access control, row level security and audit logs are enforced inside the database, not in a layer in front of it.',
        icon: Database,
        color: 'text-sky-400',
        bg: 'bg-sky-400/10',
    },
    {
        title: 'Open source, MIT licensed',
        description: 'The PostgreSQL extension, the CLI, the app and the full self-hosted stack are MIT licensed on GitHub. Run the whole platform on your own infrastructure for free, or let the managed cloud operate it for you.',
        href: 'https://github.com/Semantius',
        icon: Github,
        color: 'text-emerald-400',
        bg: 'bg-emerald-400/10',
    },
    {
        title: 'A UI for people, tools for agents',
        description: 'Your team gets dashboards, forms, grids and charts generated from the model. Your agents get MCP servers and a CLI. Both are bound by the same permissions and validation rules, because both read the same model.',
        href: '/features',
        icon: Users,
        color: 'text-purple-400',
        bg: 'bg-purple-400/10',
    },
];

const homeFaqs = [
  { question: 'Is this boilerplate free to use?', answer: 'Yes! The core template is open-source and free to use for personal and commercial projects. We also offer a Pro version with advanced features and dedicated support.' },
  { question: 'Do I need to know React?', answer: 'While we use React for interactive islands, you can use any framework you prefer (Vue, Svelte, Solid) or just sticking to vanilla JS. Astro is framework-agnostic by design.' },
  { question: 'How does the search functionality work?', answer: 'We use Pagefind, a static search library that indexes the site at build time. The browser fetches only the small index chunks that match your query, so results are instant with no search server or API key.' },
  { question: 'Can I deploy this to Vercel/Netlify?', answer: 'Absolutely. The template is pre-configured with adapters for Vercel, Netlify, and Cloudflare Pages. Just push to GitHub and connect your repository.' },
  { question: "What makes this 'premium'?", answer: 'Beyond the design, we include production-grade setups for SEO, analytics, sitemaps, RSS feeds, open graph images, dark mode, and accessibility out of the box.' },
];

---

<Layout title="Semantius | Engineered for the Unknown" description="Define your domain model and deploy a governed PostgreSQL backend: REST APIs, an admin UI for your team, and guardrails for your agents. Open source, MIT licensed, self-hosted or managed.">
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "Semantius",
            "url": Astro.site,
            "potentialAction": {
                "@type": "SearchAction",
                "target": {
                    "@type": "EntryPoint",
                    "urlTemplate": `${Astro.site}/search?q={search_term_string}`
                },
                "query-input": "required name=search_term_string"
            }
        }} />
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "Semantius",
            "operatingSystem": "Web",
            "applicationCategory": "DeveloperApplication",
            "offers": {
                "@type": "Offer",
                "price": "0",
                "priceCurrency": "USD"
            }
        }} />

    <Hero
        badge="The Open Source Agentic Data Platform"
        title="The Agent-Ready Architecture:"
        highlight="No SaaS Silos. No Custom Code Debt."
        description={`Until now, you had two bad choices for the agentic age: buy a rigid SaaS that traps your data, or "vibe-code" a custom mess you have to maintain forever. Semantius is the third option: define your domain model and deploy. A real PostgreSQL database, REST APIs, an admin UI for your team and guardrails for your agents go live together. Open source under MIT, self-hosted or managed.`}
        primaryCta={{ text: 'Deploy your first blueprint', href: `/pricing` }}
        secondaryCta={{ text: 'Explore blueprint library', href: `/blueprints` }}
    />

    <Section class="py-8! md:py-12!">
        <div class="max-w-5xl mx-auto px-6">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-y border-foreground/15">
                            <th class="py-5 pr-6 font-medium text-sm text-muted-foreground"></th>
                            <th class="py-5 px-6 font-semibold text-base">Traditional SaaS</th>
                            <th class="py-5 px-6 font-semibold text-base">Custom build</th>
                            <th class="py-5 px-6 font-semibold text-base text-primary">Semantius</th>
                        </tr>
                    </thead>
                    <tbody>
                        {comparisonRows.map((row, i) => (
                            <tr class={i === comparisonRows.length - 1 ? 'border-b border-foreground/15' : 'border-b border-foreground/10'}>
                                <td class="py-5 pr-6 text-sm text-muted-foreground">{row.label}</td>
                                <td class="py-5 px-6 text-sm">{row.point}</td>
                                <td class="py-5 px-6 text-sm">{row.custom}</td>
                                <td class="py-5 px-6 text-sm font-medium">{row.semantius}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
        </div>
    </Section>

    <Section class="py-16! md:py-20!">
        <Container class="relative z-10">
            <Grid cols={3}>
                {pillars.map((pillar) => {
                    const Icon = pillar.icon;
                    const cardClass = "group block p-8 rounded-3xl bg-foreground/2 border border-foreground/10 hover:border-primary/20 hover:bg-foreground/3 transition-all duration-300";
                    const inner = (
                        <>
                            <div class={`w-12 h-12 rounded-xl ${pillar.bg} ${pillar.color} flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500`}>
                                <Icon size={24} />
                            </div>
                            <h2 class="text-xl font-bold mb-3">{pillar.title}</h2>
                            <p class="text-foreground/60 text-sm leading-relaxed">{pillar.description}</p>
                        </>
                    );
                    return pillar.href ? (
                        <a href={pillar.href} class={cardClass}>{inner}</a>
                    ) : (
                        <div class={cardClass}>{inner}</div>
                    );
                })}
            </Grid>
        </Container>
    </Section>

    <LatestPosts count={6}/>

    {/*
    <Section class="py-0 overflow-visible">
    <FAQ items={homeFaqs} />
    </Section>
    */}

    <CTA
        title='Ready to <br /><span class="text-primary">Launch?</span>'
        description='Stop SaaS sprawl now. Consolidate your tools and model your business on a single semantic platform with Semantius.'
        primaryBtn={{ text: 'Get Started Now', href: `/pricing` }}
        secondaryBtn={{ text: 'Contact Sales', href: `/contact` }}
        disclaimer='No credit card required for open source. 14-day free trial for Pro.'
    />

</Layout>
