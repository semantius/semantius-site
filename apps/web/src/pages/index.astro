---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Schema from '~/components/layout/Schema.astro';
import Section from '~/components/layout/Section.astro';
import Hero from '~/components/sections/Hero.astro';
import CTA from '~/components/sections/CTA.astro';
import Container from '~/components/ui/Container.astro';
import Placeholder from '~/components/common/Placeholder.astro';
import { cloudOffers } from '~/data/pricing';

// Built from the founder's home page specification (v0). Its order: the claim,
// What it is (at most 3 sections), How it works (at most 5), paths for other
// readers, the sign-up call to action. Everything not decided yet is a
// Placeholder, which keeps the page off production (see Placeholder.astro).

// Both sign-up buttons on the page. `#signup` opens the same wait list overlay
// as the header's Sign up button. The target and label at launch are not
// decided; change them here and both buttons follow.
const signUp = { text: 'Sign up', href: '#signup' };

const otherReaders = ['For IT', 'For builders', 'Comparisons'];
---

<Layout
    title="Semantius | The Agent-First Data Platform"
    description="Tell the agent you already use what your business runs on. It sets up the system in Semantius and works in it every day. Your people log into a web app that works on their phones."
>
    {/* No SearchAction: the site has no /search page, only the search overlay. */}
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "Semantius",
            "url": Astro.site,
        }} />
    {/* No aggregateRating or review markup: there are no reviews to cite. */}
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "Semantius",
            "operatingSystem": "Web",
            "applicationCategory": "DeveloperApplication",
            "offers": cloudOffers(Astro.site),
        }} />

    <Hero
        badge="The agent-first data platform"
        title="Your agent runs it,"
        highlight="your people get the app"
        description="Tell the agent you already use, such as Muse or Claude Code, what your business runs on: clients and projects, jobs and crews, or bookings and turnovers. It sets up the system in Semantius and then works in it every day, keeping records current and moving work along. Your people log into a web app that works on their phones, and each sees only what their role allows."
        primaryCta={signUp}
    />

    <Section id="what-it-is" class="py-8! md:py-12!">
        <Container class="max-w-5xl">
            <Placeholder label="What it is" note="Up to 3 sections. The copy is not decided yet." />
        </Container>
    </Section>

    <Section id="how-it-works" class="py-8! md:py-12!">
        <Container class="max-w-5xl">
            <Placeholder label="How it works" note="Up to 5 sections, written once What it is is settled. The copy is not decided yet." />
        </Container>
    </Section>

    <Section id="other-readers" class="py-8! md:py-12!">
        <Container class="max-w-5xl">
            <Placeholder label="Paths for other readers" note="Three links. Their target pages are not decided yet.">
                <ul class="mt-4 flex flex-wrap gap-3">
                    {otherReaders.map((label) => (
                        <li class="rounded-full border border-dashed border-foreground/25 px-4 py-2 text-sm font-medium">{label}</li>
                    ))}
                </ul>
            </Placeholder>
        </Container>
    </Section>

    <CTA primaryBtn={signUp}>
        <Placeholder class="mb-10" label="Final call to action" note="The heading and text above the button are not decided yet." />
    </CTA>

</Layout>
