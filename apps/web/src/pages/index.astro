---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Schema from '~/components/layout/Schema.astro';
import Section from '~/components/layout/Section.astro';
import CTA from '~/components/sections/CTA.astro';
import DataModelGraphic from '~/components/sections/DataModelGraphic.astro';
import LiveDemo from '~/components/sections/LiveDemo.astro';
import Container from '~/components/ui/Container.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import { CLOUD_PLANS, SIGN_UP_URL, cloudOffers, usd } from '~/data/pricing';
import { SOLUTIONS } from '~/data/solutions';
import { HUB_SPECIFICATION } from '~/data/specification';
import { ACTION_LINKS } from '~/site.config';

// The founder's v1 specification as amended by change request 1, with the copy
// as given. Where the build departs from it, home-deviations.md says how and
// why; open gaps carry a TBD label and are listed in home-tbd.md.
//
// The hub names no install command, no test count and no CLI anywhere, and no
// technology (PostgreSQL, JSONLogic, PostgREST, React) above #specifications.

// Once a live sandbox exists, this becomes "Deploy a live sandbox (1-click)".
const startFree = { text: 'Start free', href: SIGN_UP_URL };

// Prices and the user limit come from the pricing data, so this page and
// /pricing cannot state different figures.
const plan = Object.fromEntries(CLOUD_PLANS.map((p) => [p.key, p]));
const pricingLine = `Free is open now, for up to ${plan.free.userLimit} users, people and agents. Starter (${usd(plan.starter.monthlyPrice)} a month) and Pro (${usd(plan.pro.monthlyPrice)} a month) open soon, not priced per user, with no surprise charges. Your Free workspace upgrades in place.`;

const routingCards = [
    {
        reader: SOLUTIONS.guardrails.readerLabel,
        question: 'Enforcing guardrails for your AI agents?',
        line: 'Your rules live in the database and are checked on every write, from any app, API or agent login.',
        href: SOLUTIONS.guardrails.path,
        link: SOLUTIONS.guardrails.linkLabel,
    },
    {
        reader: SOLUTIONS.apps.readerLabel,
        question: 'Need an Airtable alternative?',
        line: 'Get a relational database with an app generated from your model, and rules every agent has to follow.',
        href: SOLUTIONS.apps.path,
        link: SOLUTIONS.apps.linkLabel,
    },
    {
        reader: SOLUTIONS.crm.readerLabel,
        question: 'Building a tailored CRM?',
        line: "Consolidate sales, support and usage into one model, so your agent can connect a ticket to the customer's usage and the open deal.",
        href: SOLUTIONS.crm.path,
        link: SOLUTIONS.crm.linkLabel,
    },
    {
        reader: 'For lean developers',
        question: 'Sick of data middleware bloat?',
        line: 'Skip the sync pipelines between your tools: one model, where your agents and your people work on the same records.',
        href: '#specifications',
        link: 'Read the architecture',
    },
];

const specItems = [
    {
        title: 'Eliminating semantic drift',
        text: "Business rules are defined once in the active data dictionary, as JSONLogic stored and evaluated inside PostgreSQL, and checked on every write: from the app, the API or any agent's own login. A rule in a system prompt is followed most of the time. A rule in the database is checked every time. An agent can't write data your rules don't allow.",
    },
    {
        title: 'Real-time actions on live records',
        text: 'Agents work on the live records, not on a copy that drifts. Changes that matter, such as a new record, a status change or an approval waiting, go into queues an always-on agent picks up, and incoming webhooks (Pro) bring events from your other tools as they happen.',
    },
    {
        title: 'Unified context ingestion',
        text: "Support tickets, product usage events and CRM records arrive through imports and incoming webhooks (Pro), mapped to the entities and fields of one model with enforced relationships. Your agent follows a ticket to the customer's usage and the open deal instead of matching names across tools.",
    },
    {
        title: 'Agents as accountable users',
        text: 'Every agent works under its own login and role, like any person. When a change is refused, the agent is told which permission is missing, and it can look up in the model who holds it. Every change to data and to the model is logged: who made it, person or agent, and when.',
    },
    {
        title: 'Who does the work, who approves it',
        text: 'Lifecycle steps carry permission gates. Only the role allowed to take a step can take it, and only the person who has to approve can approve.',
    },
    {
        title: 'A model your agent can read',
        text: 'Every entity, field and relationship carries its description, readable at any time, so every agent session starts from the same understanding of your business.',
    },
];

// The v1 hub FAQ's answer, unchanged (change request 1, §6).
const comparedWith =
    'Everything you run yourself in Semantius is MIT, at any company size; Directus needs a commercial license once you reach 50 employees or $5M in revenue, even self-hosted. Directus enforces its permissions in its app server, so they apply to everyone who goes through Directus; Semantius enforces them in Postgres, so they also hold for another app, a script or a SQL client connected straight to the database. Supabase gives you Postgres and row-level security you write yourself; Semantius gives you the model, rules, roles, approval steps and app, defined once. In Airtable, rules live in the app and an agent usually gets one broad API key; in Semantius each agent has its own login and role, checked in the database.';

const contracts = [
    { label: 'Limits', text: "you get a warning first. At its limits, a workspace pauses with all your data kept, until the next month's credits arrive, you top up, or you move to a larger plan." },
    { label: 'Support', text: 'Free: the documentation. Starter and Pro: support. Self-hosted: paid support plans.' },
    { label: 'Your data', text: 'everything you run yourself is MIT. Export one module or everything at any time.' },
    { label: 'Compared with Directus, Supabase and Airtable', text: comparedWith },
];

const github = ACTION_LINKS.social.github;
const freeOffer = cloudOffers(Astro.site).filter((o) => o.name === plan.free.name);

const h2 = 'text-3xl md:text-5xl font-display font-bold';
const link = 'font-medium text-primary hover:underline underline-offset-4';
---

<Layout
    title="Semantius: the agent-first data platform on open-source Postgres"
    description="The system of record for your AI agents: business rules, approvals and permissions enforced in Postgres for every person, app and agent. Open source. Free to start."
>
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "Semantius",
            "url": Astro.site,
        }} />
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "Semantius",
            "operatingSystem": "Web",
            "applicationCategory": "DeveloperApplication",
            "license": "https://opensource.org/licenses/MIT",
            "codeRepository": github,
            "isAccessibleForFree": true,
            "offers": freeOffer,
        }} />
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "SoftwareSourceCode",
            "name": "Semantius",
            "codeRepository": github,
            "license": "https://opensource.org/licenses/MIT",
        }} />

    {/* 2. Hero: inverts the site theme (theme-inverse in components.css). */}
    <section class="theme-inverse bg-background text-foreground pt-44 pb-20 md:pt-40 md:pb-28">
        <Container class="grid gap-14 lg:grid-cols-[1.2fr_1fr] lg:items-center">
            <div>
                <Badge class="mb-6 border-foreground/10">The agent-first data platform</Badge>
                <h1 class="text-4xl md:text-6xl font-bold tracking-tight">Your AI agents are ready. Don't let your data hold them back.</h1>
                <p class="mt-6 text-lg md:text-xl text-foreground/85 leading-relaxed">Stop stuffing business rules into fragile prompts. Our active data dictionary turns your data model into an API for your agents and an app for your team, at the same time. Enforce your guardrails in the database, and run your workflows with the agent you already use.</p>
                <p class="mt-4 text-sm text-foreground/70">Works with always-on agents like Meta Muse, OpenAI Dots and Grokbot.</p>
                <div class="mt-8 flex flex-col sm:flex-row gap-4">
                    <Button href={startFree.href} size="lg" class="rounded-full">{startFree.text}</Button>
                    <Button href="#specifications" variant="outline" size="lg" class="rounded-full border-foreground/30">Read the architecture manifesto</Button>
                </div>
            </div>
            <DataModelGraphic />
        </Container>
    </section>

    {/* 3. Routing grid */}
    <Section id="routing" class="py-16! md:py-24!">
        <Container class="max-w-5xl">
            <ul class="grid gap-6 md:grid-cols-2">
                {routingCards.map((card) => (
                    <li class="flex flex-col p-8 rounded-3xl bg-foreground/2 border border-foreground/10">
                        <p class="text-sm font-semibold text-primary mb-2">{card.reader}</p>
                        <h3 class="text-xl font-bold mb-3">{card.question}</h3>
                        <p class="text-foreground/70 leading-relaxed mb-6">{card.line}</p>
                        <a href={card.href} class={`${link} mt-auto self-start`}>{card.link} <span aria-hidden="true">→</span></a>
                    </li>
                ))}
            </ul>
        </Container>
    </Section>

    {/* 4. Live demo */}
    <Section id="demo" class="py-16! md:py-24!">
        <Container class="max-w-6xl">
            <LiveDemo headingClass={h2} />
        </Container>
    </Section>

    {/* 5. Yours to keep */}
    <Section id="yours-to-keep" class="py-16! md:py-24!">
        <Container class="max-w-3xl">
            <h2 class={`${h2} mb-6`}>Yours to keep</h2>
            <p class="text-lg text-foreground/70 leading-relaxed">Most tools let you export a spreadsheet. With Semantius you keep the whole system: the data, the rules, the permissions and the app. Everything you run yourself is open source under the MIT license. Export one module or everything at any time, move it from testing to production or onto a customer's server, or run all of it on your own server.</p>
            <p class="mt-6"><a href="/docs/self-hosted" class={link}>Self-hosting</a></p>
        </Container>
    </Section>

    {/* 6. Technical platform specifications and operational contracts */}
    <Section id="specifications" class="py-16! md:py-24! scroll-mt-28">
        <Container class="max-w-4xl">
            <h2 class={`${h2} mb-12`}>Technical Platform Specifications &amp; Operational Contracts</h2>
            <ul class="grid gap-x-10 gap-y-8 md:grid-cols-2">
                {specItems.map((item) => (
                    <li>
                        <h3 class="text-xl font-bold mb-2">{item.title}</h3>
                        <p class="text-foreground/75 leading-relaxed">{item.text}</p>
                    </li>
                ))}
            </ul>
            <div class="mt-12 relative overflow-x-auto rounded-2xl border border-foreground/10">
                <table class="w-full text-left text-sm md:text-base">
                    <tbody>
                        {HUB_SPECIFICATION.map(([name, value]) => (
                            <tr class="border-b border-foreground/10 last:border-b-0">
                                <th scope="row" class="p-4 align-top font-semibold whitespace-nowrap">{name}</th>
                                <td class="p-4 text-foreground/80">{value}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <h3 class="mt-12 text-2xl font-bold mb-4">Operational contracts</h3>
            <ul class="list-disc pl-5 space-y-3 text-foreground/80 leading-relaxed">
                <li>
                    <strong class="text-foreground">Plans:</strong> {pricingLine}
                    <span class="ml-1 inline-flex gap-4"><a href="#signup" class={link}>Notify me</a><a href="/pricing" class={link}>See pricing</a></span>
                </li>
                {contracts.map((c) => (
                    <li><strong class="text-foreground">{c.label}:</strong> {c.text}</li>
                ))}
            </ul>
        </Container>
    </Section>

    {/* 7. Final call to action */}
    <CTA
        title="Your agents are ready. Give them a system of record."
        primaryBtn={startFree}
    />
</Layout>
