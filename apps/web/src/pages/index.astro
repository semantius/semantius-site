---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Schema from '~/components/layout/Schema.astro';
import Section from '~/components/layout/Section.astro';
import CTA from '~/components/sections/CTA.astro';
import DataModelGraphic from '~/components/sections/DataModelGraphic.astro';
import LiveDemo from '~/components/sections/LiveDemo.astro';
import Container from '~/components/ui/Container.astro';
import Badge from '~/components/ui/Badge.astro';
import Button from '~/components/ui/Button.astro';
import { CLOUD_PLANS, SIGN_UP_URL, cloudOffers } from '~/data/pricing';
import { SOLUTIONS } from '~/data/solutions';
import { ACTION_LINKS } from '~/site.config';

// The founder's v1 specification as amended by change requests 1 and 2, with
// the copy as given. Where the build departs from it, home-deviations.md says how and
// why; open gaps carry a TBD label and are listed in home-tbd.md.
//
// The hub names no install command, no test count and no CLI anywhere, and no
// technology (PostgreSQL, JSONLogic, PostgREST, React) above #specifications.

// Once a live sandbox exists, this becomes "Deploy a live sandbox (1-click)".
const startFree = { text: 'Start free', href: SIGN_UP_URL };

const routingCards = [
    {
        reader: SOLUTIONS.guardrails.readerLabel,
        question: 'Enforcing guardrails for your AI agents?',
        line: 'Your rules live in the database and are checked on every write, from any app, API or agent login.',
        href: SOLUTIONS.guardrails.path,
        link: SOLUTIONS.guardrails.linkLabel,
    },
    {
        reader: SOLUTIONS.apps.readerLabel,
        question: 'Need an Airtable alternative?',
        line: 'Get a relational database with an app generated from your model, and rules every agent has to follow.',
        href: SOLUTIONS.apps.path,
        link: SOLUTIONS.apps.linkLabel,
    },
    {
        reader: SOLUTIONS.crm.readerLabel,
        question: 'Building a tailored CRM?',
        line: "Consolidate sales, support and usage into one model, so your agent can connect a ticket to the customer's usage and the open deal.",
        href: SOLUTIONS.crm.path,
        link: SOLUTIONS.crm.linkLabel,
    },
    {
        reader: 'For lean developers',
        question: 'Sick of data middleware bloat?',
        line: 'Skip the sync pipelines between your tools: one model, where your agents and your people work on the same records.',
        href: '#specifications',
        link: 'Read the architecture',
    },
];

// #specifications (change request 2, §2). A point is a bold label and the
// text after it, which starts in lowercase as given.
interface Item {
    title: string;
    lead?: string;
    points: [string, string][];
    after?: string;
}

const architecture: Item[] = [
    {
        title: 'Eliminating semantic drift',
        lead: 'One active data dictionary defines your business.',
        points: [
            ['The model', 'every entity, every field, every relationship with its cardinality, subtypes and extensions, each with its description, dimensions and measures.'],
            ['The business rules', 'extended JSONLogic, stored and evaluated inside PostgreSQL, for validation, computed fields and attribute-based access.'],
            ['One source for everything', "the same definition drives the API, the app your team uses and what your agent reads. No generated code restates it, so there's no second copy to drift away from it."],
        ],
        after: 'A rule in a system prompt is read again in every session and followed most of the time. A rule in the database is evaluated on every write.',
    },
    {
        title: 'Real-time actions on live records',
        lead: 'Agents act on the live system of record, not on an export or a copy kept in sync.',
        points: [
            ['Queues', 'changes that matter are put into queues with event and rule triggers: a new record, a status change, an approval waiting. An always-on agent picks them up on its next check.'],
            ['Incoming webhooks (Pro)', 'they bring events from your other tools as they happen, authenticated and mapped to your entities and fields.'],
        ],
    },
    {
        title: 'Unified context ingestion',
        points: [
            ['Getting data in', 'existing data comes in through CSV import and JSON modules. Continuous events arrive through incoming webhooks (Pro).'],
            ['One model', 'support tickets, product usage events and CRM records land in one model whose relationships are enforced by foreign keys.'],
            ['What the agent does with it', "it follows a ticket to the customer's usage and the open deal by reference, instead of matching names across tools."],
            ['Search', 'full-text search runs across all of it.'],
        ],
    },
    {
        title: 'Agents as accountable actors',
        lead: 'People and agents are both actors.',
        points: [
            ['Login and role', 'every agent signs in with its own token and works under its own role.'],
            ['Enforcement', 'role-based and attribute-based access control is enforced inside the database, with row-level security, for every caller.'],
            ['Refusals', 'a refused change returns the reason, the missing permission, and the agent can query the dictionary to see who holds it.'],
            ['The model', 'changing the model itself requires its own permission.'],
        ],
    },
    {
        title: 'Who does the work, who approves it',
        lead: 'State machines define the steps a record can go through, and enforce that it moves only along them.',
        points: [
            ['Permission gates', 'each step has a gate, so only a role allowed to take it can take it.'],
            ['Doing and approving', 'where you define who does the work and who approves it, the database enforces both.'],
        ],
    },
    {
        title: 'A model your agent can read',
        points: [
            ['Readable at runtime', "the dictionary's descriptions, relationships, dimensions and measures can be read at any time through the same API the agent uses."],
            ['No manual needed', 'every agent session starts from the same understanding of your business, without out-of-band instructions.'],
        ],
    },
];

// The guarantees: the bold part, then the rest of the sentence.
const contracts: [string, string][] = [
    ['Every write is checked', ' against the rules defined for it.'],
    ['The same change, from the same role, against the same record, always gets the same answer.', ''],
    ['A refused change leaves the record as it was', ' and returns the reason.'],
    ['A record moves only along the steps defined for it,', ' and only by a role allowed to take the step.'],
    ["A reference can't point to a record that doesn't exist.", ''],
    ['Changing the model requires its own permission.', ''],
    ['Every change to data and to the model is logged,', ' with who made it, person or agent, and when.'],
];

const outsideContracts = [
    'Whether an agent chose the right action',
    'Whether a value that passes your rules is the right one',
    'A database superuser or table owner, who can bypass row-level security',
];

const github = ACTION_LINKS.social.github;
// The structured data's offer is the Free plan only (home-tbd.md, B10).
const freePlan = CLOUD_PLANS.find((p) => p.key === 'free');
const freeOffer = cloudOffers(Astro.site).filter((o) => o.name === freePlan?.name);

const h2 = 'text-3xl md:text-5xl font-display font-bold';
const h3 = 'mt-14 text-2xl md:text-3xl font-bold';
const h4 = 'mt-8 mb-3 text-lg font-bold';
const body = 'text-foreground/75 leading-relaxed';
const list = 'list-disc pl-5 space-y-2 text-foreground/75 leading-relaxed';
const link = 'font-medium text-primary hover:underline underline-offset-4';
---

<Layout
    title="Semantius: the agent-first data platform on open-source Postgres"
    description="The system of record for your AI agents: business rules, approvals and permissions enforced in Postgres for every person, app and agent. Open source. Free to start."
>
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "WebSite",
            "name": "Semantius",
            "url": Astro.site,
        }} />
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "SoftwareApplication",
            "name": "Semantius",
            "operatingSystem": "Web",
            "applicationCategory": "DeveloperApplication",
            "license": "https://opensource.org/licenses/MIT",
            "codeRepository": github,
            "isAccessibleForFree": true,
            "offers": freeOffer,
        }} />
    <Schema item={{
            "@context": "https://schema.org",
            "@type": "SoftwareSourceCode",
            "name": "Semantius",
            "codeRepository": github,
            "license": "https://opensource.org/licenses/MIT",
        }} />

    {/* 2. Hero: inverts the site theme (theme-inverse in components.css). */}
    <section class="theme-inverse bg-background text-foreground pt-44 pb-20 md:pt-40 md:pb-28">
        <Container class="grid gap-14 lg:grid-cols-[1.2fr_1fr] lg:items-center">
            <div>
                <Badge class="mb-6 border-foreground/10">The agent-first data platform</Badge>
                <h1 class="text-4xl md:text-6xl font-bold tracking-tight">Your AI agents are ready. Don't let your data hold them back.</h1>
                <p class="mt-6 text-lg md:text-xl text-foreground/85 leading-relaxed">Stop stuffing business rules into fragile prompts. Our active data dictionary turns your data model into an API for your agents and an app for your team, at the same time. Enforce your guardrails in the database, and run your workflows with the agent you already use.</p>
                <p class="mt-4 text-sm text-foreground/70">Works with always-on agents like Meta Muse, OpenAI Dots and Grokbot.</p>
                <div class="mt-8 flex flex-col sm:flex-row gap-4">
                    <Button href={startFree.href} size="lg" class="rounded-full">{startFree.text}</Button>
                    <Button href="#specifications" variant="outline" size="lg" class="rounded-full border-foreground/30">Read the architecture manifesto</Button>
                </div>
            </div>
            <DataModelGraphic />
        </Container>
    </section>

    {/* 3. Routing grid */}
    <Section id="routing" class="py-16! md:py-24!">
        <Container class="max-w-5xl">
            <ul class="grid gap-6 md:grid-cols-2">
                {routingCards.map((card) => (
                    <li class="flex flex-col p-8 rounded-3xl bg-foreground/2 border border-foreground/10">
                        <p class="text-sm font-semibold text-primary mb-2">{card.reader}</p>
                        <h3 class="text-xl font-bold mb-3">{card.question}</h3>
                        <p class="text-foreground/70 leading-relaxed mb-6">{card.line}</p>
                        <a href={card.href} class={`${link} mt-auto self-start`}>{card.link} <span aria-hidden="true">→</span></a>
                    </li>
                ))}
            </ul>
        </Container>
    </Section>

    {/* 4. Live demo */}
    <Section id="demo" class="py-16! md:py-24!">
        <Container class="max-w-6xl">
            <LiveDemo headingClass={h2} />
        </Container>
    </Section>

    {/* 5. Yours to keep */}
    <Section id="yours-to-keep" class="py-16! md:py-24!">
        <Container class="max-w-3xl">
            <h2 class={`${h2} mb-6`}>Yours to keep</h2>
            <p class="text-lg text-foreground/70 leading-relaxed">Most tools let you export a spreadsheet. With Semantius you keep the whole system: the data, the rules, the permissions and the app. Everything you run yourself is open source under the MIT license. Export one module or everything at any time, move it from testing to production or onto a customer's server, or run all of it on your own server.</p>
            <p class="mt-6"><a href="/docs/self-hosted" class={link}>Self-hosting</a></p>
        </Container>
    </Section>

    {/* 6. Technical platform specifications and operational contracts: dense
        text for technical readers and answer engines, with no cards, tables or
        icons (change request 2). */}
    <Section id="specifications" class="py-16! md:py-24! scroll-mt-28">
        <Container class="max-w-3xl">
            <h2 class={`${h2} mb-6`}>Technical Platform Specifications &amp; Operational Contracts</h2>
            <p class="text-lg text-foreground/75 leading-relaxed">Semantius keeps the records your agents work on correct by construction, not by instruction. The rules live in the database, next to the data, and every change passes through them. This section explains how the architecture achieves that, and what it guarantees.</p>

            <h3 class={h3}>How the architecture keeps records correct</h3>
            {architecture.map((item) => (
                <>
                    <h4 class={h4}>{item.title}</h4>
                    {item.lead && <p class={`${body} mb-3`}>{item.lead}</p>}
                    <ul class={list}>
                        {item.points.map(([label, text]) => (
                            <li><strong class="text-foreground">{label}:</strong> {text}</li>
                        ))}
                    </ul>
                    {item.after && <p class={`${body} mt-3`}>{item.after}</p>}
                </>
            ))}

            <h3 class={h3}>Operational contracts</h3>
            <p class={`${body} mb-3`}>These hold for every app, API and agent login:</p>
            <ul class={list}>
                {contracts.map(([bold, rest]) => (
                    <li><strong class="text-foreground">{bold}</strong>{rest}</li>
                ))}
            </ul>
            <h4 class={h4}>Outside these contracts</h4>
            <ul class={list}>
                {outsideContracts.map((item) => <li>{item}</li>)}
            </ul>
        </Container>
    </Section>

    {/* 7. Final call to action */}
    <CTA
        title="Your agents are ready. Give them a system of record."
        primaryBtn={startFree}
    />
</Layout>
