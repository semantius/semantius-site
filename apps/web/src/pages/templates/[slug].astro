---
export const prerender = true;
import { ChevronDown } from 'lucide-react';
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import Command from '~/components/common/Command.astro';
import {
	TEMPLATE_CATEGORIES,
	TEMPLATE_GROUPS,
	templateCategoryPath,
	type TemplateCategory,
} from '~/data/templates';

// One page per category, loosely following Airtable's template gallery: the
// category sidebar beside that category's prompts. /templates itself
// redirects to the first category (astro.config.mjs).

export function getStaticPaths() {
	return TEMPLATE_CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props as { category: TemplateCategory };
const path = templateCategoryPath(category);
---

<Layout
	title={`${category.name} templates`}
	breadcrumbs={[{ name: 'Home', href: '/' }, { name: category.name, href: path }]}
>
	<PageHeader class="pb-10">
		<Container>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight">Templates</h1>
		</Container>
	</PageHeader>
	<section class="pb-24">
		<Container class="grid gap-10 lg:grid-cols-[260px_1fr] lg:gap-12">
			<aside aria-label="Template categories" class="lg:sticky lg:top-24 lg:self-start lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto [scrollbar-width:thin]">
				{TEMPLATE_GROUPS.map((g) => (
					<details open class="group mb-6">
						<summary class="flex cursor-pointer list-none items-center justify-between py-2 text-sm font-semibold text-foreground/60 [&::-webkit-details-marker]:hidden">
							{g.label}
							<ChevronDown className="h-4 w-4 transition-transform group-open:rotate-180" aria-hidden="true" />
						</summary>
						<ul class="mt-2 space-y-1">
							{g.categories.map((c) => {
								const current = c.slug === category.slug;
								return (
									<li>
										<a
											href={templateCategoryPath(c)}
											aria-current={current ? 'page' : undefined}
											class:list={['block py-1 hover:text-primary', current ? 'font-semibold text-primary' : 'text-foreground/90']}
										>{c.name}</a>
									</li>
								);
							})}
						</ul>
					</details>
				))}
			</aside>
			<div class="min-w-0">
				<h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">{category.name}</h2>
				<ul class="grid gap-6 md:grid-cols-2">
					{category.templates.map((t) => (
						<li class="flex flex-col p-6 rounded-3xl bg-foreground/2 border border-foreground/10">
							<h3 class="text-lg font-bold mb-4">{t.title}</h3>
							<Command mode="chat" runnable command={t.prompt} />
						</li>
					))}
				</ul>
			</div>
		</Container>
	</section>
</Layout>
