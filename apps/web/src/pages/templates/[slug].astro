---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import Command from '~/components/common/Command.astro';
import TemplatesNav from '~/components/templates/TemplatesNav.astro';
import {
	TEMPLATE_CATEGORIES,
	TEMPLATES_PATH,
	templateCategoryPath,
	type TemplateCategory,
} from '~/data/templates';

// One page per category, loosely following Airtable's template gallery: the
// category navigation beside that category's prompts. /templates (index.astro)
// lists every category on one page.

export function getStaticPaths() {
	return TEMPLATE_CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { category: c } }));
}

const { category } = Astro.props as { category: TemplateCategory };
const path = templateCategoryPath(category);
---

<Layout
	title={`${category.name} templates`}
	breadcrumbs={[
		{ name: 'Home', href: '/' },
		{ name: 'Templates', href: TEMPLATES_PATH },
		{ name: category.name, href: path },
	]}
>
	<PageHeader class="pb-10">
		<Container>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight">Templates</h1>
		</Container>
	</PageHeader>
	<section class="pb-24">
		<Container class="grid gap-10 lg:grid-cols-[260px_1fr] lg:gap-12">
			<TemplatesNav current={category.slug} />
			<div class="min-w-0">
				<h2 class="text-2xl md:text-3xl font-bold tracking-tight mb-6">{category.name}</h2>
				<ul class="grid gap-6 md:grid-cols-2">
					{category.templates.map((t) => (
						<li class="flex flex-col p-6 rounded-3xl bg-foreground/2 border border-foreground/10">
							<h3 class="text-lg font-bold mb-4">{t.title}</h3>
							<Command mode="chat" runnable command={t.prompt} />
						</li>
					))}
				</ul>
			</div>
		</Container>
	</section>
</Layout>
