---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/ui/Container.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import Command from '~/components/common/Command.astro';
import TemplatesNav from '~/components/templates/TemplatesNav.astro';
import { TEMPLATE_CATEGORIES, TEMPLATES_PATH, templateCategoryPath } from '~/data/templates';

// Every template on one page, a section per category. Each category also has
// its own page ([slug].astro), which the section heading links to.
---

<Layout
	title="Templates"
	breadcrumbs={[{ name: 'Home', href: '/' }, { name: 'Templates', href: TEMPLATES_PATH }]}
>
	<PageHeader class="pb-10">
		<Container>
			<h1 class="text-4xl md:text-5xl font-bold tracking-tight">Templates</h1>
		</Container>
	</PageHeader>
	<section class="pb-24">
		<Container class="grid gap-10 lg:grid-cols-[260px_1fr] lg:gap-12">
			<TemplatesNav anchors />
			<div class="min-w-0 space-y-16">
				{TEMPLATE_CATEGORIES.map((c) => (
					<section aria-labelledby={c.slug}>
						<h2 id={c.slug} class="scroll-mt-24 text-2xl md:text-3xl font-bold tracking-tight mb-6">
							<a href={templateCategoryPath(c)} class="hover:text-primary transition-colors">{c.name}</a>
						</h2>
						<ul class="grid gap-6 md:grid-cols-2">
							{c.templates.map((t) => (
								<li class="flex flex-col p-6 rounded-3xl bg-foreground/2 border border-foreground/10">
									<h3 class="text-lg font-bold mb-4">{t.title}</h3>
									<Command mode="chat" runnable command={t.prompt} />
								</li>
							))}
						</ul>
					</section>
				))}
			</div>
		</Container>
	</section>
</Layout>
