  </Container>

  <FAQ items={faqs} />
</Layout>

<style is:global>
  /* The inline script above sets data-pricing-tab before the panels paint. */
  html[data-pricing-tab='cloud'] [data-panel='self-hosted'],
  html[data-pricing-tab='self-hosted'] [data-panel='cloud'] {
    display: none;
  }

  [data-billing='monthly'] [data-period='yearly'],
  [data-billing='yearly'] [data-period='monthly'] {
    display: none;
  }

  [data-billing='monthly'] [data-yearly-note] {
    visibility: hidden;
  }

  html[data-pricing-tab='self-hosted'] .pricing-billing {
    display: none;
  }

  /* A visit to /pricing#self-hosted scrolls to the panel; this margin keeps
     the fixed header and the tab bar above it in view. */
  .pricing-panel {
    scroll-margin-top: 13rem;
  }
</style>

<script>
  type Tab = 'cloud' | 'self-hosted';

  const root = document.documentElement;
  const tabs = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-tab]'));
  const tabBar = document.getElementById('pricing-tabs');

  function select(tab: Tab, focus = false) {
    root.setAttribute('data-pricing-tab', tab);
    for (const el of tabs) {
      const on = el.dataset.tab === tab;
      el.setAttribute('aria-selected', String(on));
      el.tabIndex = on ? 0 : -1;
      if (on && focus) el.focus();
    }
  }

  // Cloud is the default, so its URL is plain /pricing.
  function setUrl(hash: string) {
    const url = hash === '' || hash === '#cloud' ? location.pathname + location.search : hash;
    history.replaceState(null, '', url);
  }

  /** Shows the panel holding #id and scrolls to it. False if #id is not in a panel. */
  function reveal(id: string, smooth = true): boolean {
    const target = id ? document.getElementById(id) : null;
    const panel = target?.closest<HTMLElement>('[data-panel]');
    if (!target || !panel) return false;
    select(panel.dataset.panel as Tab);
    const isPanel = target === panel;
    (isPanel && tabBar ? tabBar : target).scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
    return true;
  }

  for (const el of tabs) {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      const tab = el.dataset.tab as Tab;
      select(tab);
      setUrl(`#${tab}`);
    });
  }

  document.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
    const key = (e as KeyboardEvent).key;
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(key)) return;
    e.preventDefault();
    const current = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
    const next =
      key === 'Home' ? 0 : key === 'End' ? tabs.length - 1 : (current + (key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
    const tab = tabs[next].dataset.tab as Tab;
    select(tab, true);
    setUrl(`#${tab}`);
  });

  // In-page links such as "See Cloud" or an FAQ answer's "Self-hosted tab"
  // point into a panel that may be hidden: switch to it first. #signup is not
  // in a panel, so it falls through to the sign-up overlay's own handler.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link || link.hasAttribute('data-tab')) return;
    const hash = link.getAttribute('href') ?? '';
    if (!reveal(hash.slice(1))) return;
    e.preventDefault();
    setUrl(hash);
  });

  window.addEventListener('hashchange', () => reveal(location.hash.slice(1)));

  // The inline script only knows #self-hosted. A deeper link such as
  // #support-plans is resolved here, once the panels exist.
  if (location.hash && location.hash !== '#self-hosted' && location.hash !== '#cloud') {
    reveal(decodeURIComponent(location.hash.slice(1)), false);
  }

  const cloud = document.getElementById('cloud');
  const periodButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-billing-option]'));
  for (const button of periodButtons) {
    button.addEventListener('click', () => {
      const period = button.dataset.billingOption ?? 'monthly';
      cloud?.setAttribute('data-billing', period);
      for (const b of periodButtons) b.setAttribute('aria-pressed', String(b === button));
    });
  }

  for (const el of document.querySelectorAll<HTMLAnchorElement>('.pricing-plan-cta')) {
    el.addEventListener('click', () => {
      (window as any).posthog?.capture('pricing_plan_cta_clicked', {
        plan: el.dataset.plan,
        billing: cloud?.getAttribute('data-billing'),
      });
    });
  }
</script>
