---
export const prerender = true;
import Layout from '~/layouts/Layout.astro';
import PageHeader from '~/components/layout/PageHeader.astro';
import PageTitle from '~/components/layout/PageTitle.astro';
import Container from '~/components/ui/Container.astro';
---

<Layout title="Contact - Semantius Agentic Data Platform" description="Get in touch with the Semantius team about self-hosting, the managed cloud, semantic blueprints or an evaluation.">
  <PageHeader>
    <PageTitle
        title='Get in <span class="text-primary">Touch</span>'
        description="We'd love to hear from you. Fill out the form below or reach out directly."
    />
  </PageHeader>

  <!-- Contact Form: HubSpot embed, portal 149609610 in region eu1. -->
  <Container as="section" class="max-w-2xl pb-24">
      <script is:inline src="https://js-eu1.hsforms.net/forms/embed/149609610.js" defer></script>
      <div class="hs-form-frame" data-region="eu1" data-form-id="8c1bb5db-e5b6-4840-919a-ffcf99795bfc" data-portal-id="149609610"></div>
  </Container>
</Layout>
