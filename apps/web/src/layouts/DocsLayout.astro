---
import UntranslatedLayout from './UntranslatedLayout.astro';
import { getCollection } from 'astro:content';
import TableOfContents from '~/components/blog/TableOfContents.astro';
import type { MarkdownHeading } from 'astro';
import ScrollProgress from '~/components/layout/ScrollProgress.astro';
import MobileDocsMenu from '~/components/docs/MobileDocsMenu.astro';
import NavTree from '~/components/docs/NavTree.astro';
import DocsTabs from '~/components/docs/DocsTabs.astro';
import {
  buildDocsTree,
  flattenNodes,
  findTopAncestor,
  getDocsCollectionNavs,
  findCollectionForPath,
} from '~/lib/docs-tree';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  nofollow?: boolean;
  headings?: MarkdownHeading[];
}

const { title, description, noindex, nofollow, headings = [] } = Astro.props;

const docs = await getCollection('docs');
const tree = buildDocsTree(docs);

const currentPath = Astro.url.pathname;
const normalizedCurrentPath =
  currentPath.endsWith('/') && currentPath.length > 1
    ? currentPath.slice(0, -1)
    : currentPath;

// Everything below the tabs is scoped to the active tab: the sidebar, prev/next
// and the breadcrumb all work off the folders nav.json assigns to it, so
// navigation never bleeds from one tab into another.
const collectionNavs = getDocsCollectionNavs(tree);
// A docs page outside every tab folder still gets a route, so it needs some
// sidebar to render. It falls back to the first tab in nav.json.
const activeCollection =
  findCollectionForPath(collectionNavs, normalizedCurrentPath) ?? collectionNavs[0];

const tabs = collectionNavs.map((c) => ({
  slug: c.slug,
  label: c.label,
  href: c.landingPath,
  active: c.slug === activeCollection?.slug,
}));

// The tab's folders, assembled by nav.json rather than read off the filesystem.
const tabFolders = activeCollection?.folders ?? [];
// The tab's own index.mdx leads the sidebar, with its children dropped so it
// renders as a plain link rather than a duplicate of the folder list below it.
const sidebarNodes = activeCollection?.node.doc
  ? [{ ...activeCollection.node, children: [] }, ...tabFolders]
  : tabFolders;

const flat = activeCollection?.node.doc
  ? [activeCollection.node, ...flattenNodes(tabFolders)]
  : flattenNodes(tabFolders);
const currentIndex = flat.findIndex((n) => n.path === normalizedCurrentPath);
const prevNode = currentIndex > 0 ? flat[currentIndex - 1] : null;
const nextNode =
  currentIndex >= 0 && currentIndex < flat.length - 1 ? flat[currentIndex + 1] : null;

// Breadcrumb: Docs › <collection> › <section> › <page>, mirroring the URL. A
// level is dropped when it is the page itself, so the trail never links to the
// page you are already on, on a collection start page it reads Docs › Guide.
const topAncestor = findTopAncestor(tabFolders, normalizedCurrentPath);
const currentSectionLabel =
  topAncestor && topAncestor.path !== normalizedCurrentPath ? topAncestor.navTitle : null;

const crumbs: { label: string; href: string }[] = [{ label: 'Docs', href: '/docs' }];
if (activeCollection && activeCollection.node.path !== normalizedCurrentPath) {
  crumbs.push({ label: activeCollection.label, href: activeCollection.landingPath });
}
if (currentSectionLabel && topAncestor) {
  crumbs.push({ label: currentSectionLabel, href: topAncestor.path });
}
---

<UntranslatedLayout title={title} description={description} noindex={noindex} nofollow={nofollow}>
  <ScrollProgress />
  <div class="max-w-360 mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24">
    <DocsTabs tabs={tabs} />
    <div class="flex w-full lg:grid lg:grid-cols-[280px_1fr_240px] gap-10">

        {/* Sidebar Navigation */}
        {/* lg:overflow-visible matters: with overflow-y-auto the aside becomes
            the scrollport for the sticky child below, which then sits a fixed
            96px (top-24) below the column top and never actually sticks. The
            page has to be the scrollport instead. */}
        <aside class="hidden lg:block fixed inset-y-0 left-0 z-20 w-72 overflow-y-auto border-r border-foreground/5 bg-background px-6 pb-4 pt-32 lg:static lg:w-auto lg:overflow-visible lg:border-r-0 lg:bg-transparent lg:px-0 lg:pb-0 lg:pt-0">
             {/* -mt-1.5 cancels the first nav link's own py-1.5 and lg:-ml-3 its
                 px-3, so the link text starts on the same line and edge as the
                 breadcrumb and the "On this page" heading, which have no such
                 padding. Shifting the box (rather than the nav inside it) keeps
                 the hover pills inside the scroll area, so scrolling a long nav
                 never produces a horizontal scrollbar. */}
             <div class="sticky top-24 space-y-8 -mt-1.5 lg:-ml-3 lg:max-h-[calc(100vh-7rem)] lg:overflow-y-auto">
                 <nav class="space-y-1" aria-label="Documentation Sidebar">
                    <NavTree nodes={sidebarNodes} currentPath={normalizedCurrentPath} />
                 </nav>
             </div>
        </aside>

        {/* Main Content */}
        <div class="min-w-0 flex-1">
             {/* Breadcrumbs & Mobile Menu */}
             <div class="mb-6 flex items-center justify-between gap-4" data-pagefind-ignore>
                <div class="flex items-center gap-2 text-sm text-muted-foreground">
                    {crumbs.map((crumb) => (
                        <>
                            <a
                              href={crumb.href}
                              class="hover:text-foreground transition-colors"
                            >{crumb.label}</a>
                            <span class="text-foreground/30" aria-hidden="true">›</span>
                        </>
                    ))}
                    <span class="text-foreground">{title}</span>
                </div>

                <MobileDocsMenu
                    nodes={sidebarNodes}
                    collections={tabs}
                    currentPath={normalizedCurrentPath}
                />
             </div>

            <div class="prose prose-lg max-w-none prose-headings:font-bold prose-headings:scroll-mt-24 prose-a:text-primary hover:prose-a:text-primary/80 dark:prose-invert text-foreground prose-headings:text-foreground prose-p:text-foreground/80 prose-strong:text-foreground prose-code:text-primary prose-code:before:content-none prose-code:after:content-none prose-pre:border prose-pre:border-white/10 prose-pre:bg-black/80">
                <h1 class="text-4xl font-bold mb-8 text-foreground" data-pagefind-meta="title">{title}</h1>
                <slot />
            </div>

            {/* Next/Prev Navigation */}
            <hr class="my-10 border-foreground/10" />
            <div class="flex flex-col sm:flex-row gap-4 justify-between" data-pagefind-ignore>
                {prevNode ? (
                    <a href={prevNode.path} class="group flex flex-col gap-1 p-4 rounded-xl border border-foreground/10 hover:border-primary/30 hover:bg-primary/5 transition-all text-left">
                        <span class="text-xs text-muted-foreground font-medium group-hover:text-primary/70">Previous</span>
                        <span class="text-foreground font-bold group-hover:text-primary">{prevNode.navTitle}</span>
                    </a>
                ) : <div/>}

                 {nextNode && (
                    <a href={nextNode.path} class="group flex flex-col gap-1 p-4 rounded-xl border border-foreground/10 hover:border-primary/30 hover:bg-primary/5 transition-all text-right items-end">
                        <span class="text-xs text-muted-foreground font-medium group-hover:text-primary/70">Next</span>
                        <span class="text-foreground font-bold group-hover:text-primary">{nextNode.navTitle}</span>
                    </a>
                )}
            </div>
        </div>

        {/* Right Sidebar: Table of Contents */}
        <aside class="hidden xl:block min-w-[240px]">
            {headings.length > 0 && (
                <TableOfContents headings={headings} />
            )}
        </aside>

    </div>
  </div>
</UntranslatedLayout>
